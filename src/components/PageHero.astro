---
// Top of an inner page with no hero image: rule, eyebrow inside the H1, intro, then anything
// slotted below. On desktop the H1 runs to 70% of the width, since there's no image beside it;
// the intro stays in the left half so its lines stay a comfortable length.
import Heading from './Heading.astro';
interface Props { eyebrow: string; heading: string; intro?: string }
const { eyebrow, heading, intro } = Astro.props;
---
<section class="px-margin">
  <div class="flex flex-col gap-large border-t border-line pt-large lg:pt-[40px]">
    <div class="flex flex-col gap-loose">
      <Heading level={1} eyebrow={eyebrow} class="lg:w-[70%]">{heading}</Heading>
      {intro && <p class="t-body text-muted lg:w-half">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
