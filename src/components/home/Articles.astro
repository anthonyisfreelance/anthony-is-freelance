---
import SectionIntro from '../SectionIntro.astro';
import TextLink from '../TextLink.astro';
import { ARTICLES } from '../../data/home';
---
<section class="px-margin pt-section-sm">
  <div class="border-t border-line pt-section">
    <SectionIntro eyebrow={ARTICLES.eyebrow} heading={ARTICLES.heading}>
      <TextLink slot="links" href={ARTICLES.link.href}>{ARTICLES.link.label}</TextLink>
    </SectionIntro>
    <ul class="mt-grid-lg grid grid-cols-2 gap-x-grid gap-y-large lg:grid-cols-4">
      {ARTICLES.items.map((a) => (
        <li>
          <article class="relative flex flex-col">
            <div class="aspect-video bg-line" aria-hidden="true"></div>
            <div class="flex flex-col gap-2 pt-2">
              <p class="t-badge border-b border-line pb-2 text-muted">{a.category}</p>
              <h3 class="t-h6 text-ink"><a href={a.href} class="stretched-link hover:opacity-80">{a.title}</a></h3>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
