---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, external = false, class: className = '', ...rest } = Astro.props;
---
<a
  href={href}
  class:list={['t-button inline-flex items-center gap-1 text-ink link-hover', className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  <slot />
  <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="size-[18px]" />
</a>
