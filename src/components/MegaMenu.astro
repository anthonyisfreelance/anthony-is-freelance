---
// Desktop mega menu panels. All links are in the HTML (crawlable); panels are
// shown and hidden by the small script in Header.astro.
import { Image } from 'astro:assets';
import CaseStudyCard from './CaseStudyCard.astro';
import ScreenTile from './ScreenTile.astro';
import { MEGA } from '../data/site';
import { STORIES } from '../data/home';
import { ARTICLES_LIST } from '../data/articles';
import ArticleCard from './ArticleCard.astro';
import screen from '../assets/home/innovation-screen.png';

const link = 't-button-lg text-ink link-hover';
const featured = STORIES.featured;
const workCards = [STORIES.featured, ...STORIES.cards.filter((c) => c.href)].slice(0, 3);
---
<div class="absolute left-0 right-0 top-full z-30 hidden lg:block">
  <!-- Services -->
  <div id="mega-services" data-mega-panel hidden class="border-b border-line bg-surface px-margin pb-large pt-4">
    <div class="flex items-start justify-between gap-gutter">
      <a href={MEGA.services.viewAll.href} class={`${link} inline-flex items-center gap-2`}>
        {MEGA.services.viewAll.label}
        <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="size-[18px]" />
      </a>
      {MEGA.services.columns.map((col) => (
        <ul class="flex flex-col gap-loose">
          {col.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
        </ul>
      ))}
      <article class="hover-card relative flex w-[555px] max-w-[40%] flex-col">
        <div class="grid grid-cols-2 gap-[2px]">
          <div class="relative aspect-[4/5] overflow-hidden">
            <Image src={featured.image} alt="" widths={[280, 560]} sizes="280px" class="zoom-img absolute inset-0 size-full object-cover" />
          </div>
          <ScreenTile screen={screen} ratio="portrait" sizes="180px" />
        </div>
        <p class="t-badge flex gap-2 border-b border-line py-3 text-muted" aria-hidden="true">
          <span class="flex-1">{featured.client}</span><span class="flex-1 text-right">{featured.meta}</span>
        </p>
        <p class="t-h6 mt-3 text-ink">
          <a href={featured.href} class="stretched-link link-hover"><span class="sr-only">{featured.client}. </span>{featured.claim}</a>
        </p>
      </article>
    </div>
  </div>

  <!-- Success stories -->
  <div id="mega-work" data-mega-panel hidden class="border-b border-line bg-surface px-margin pb-large pt-4">
    <div class="flex items-start gap-gutter">
      <ul class="flex w-[318px] shrink-0 flex-col gap-loose">
        <li>
          <a href={MEGA.work.viewAll.href} class={`${link} inline-flex items-center gap-2`}>
            {MEGA.work.viewAll.label}
            <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="size-[18px]" />
          </a>
        </li>
        {MEGA.work.links.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
      <ul class="grid flex-1 grid-cols-3 gap-gutter">
        {workCards.map((c) => (
          <li><CaseStudyCard client={c.client} meta={c.meta} claim={c.claim} image={c.image} href={c.href} ratio="square" sizes="320px" /></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Articles -->
  <div id="mega-articles" data-mega-panel hidden class="border-b border-line bg-surface px-margin pb-large pt-4">
    <div class="grid grid-cols-4 gap-gutter">
      {ARTICLES_LIST.slice(0, 3).map((a) => <ArticleCard article={a} titleTag="p" ratio="square" />)}
      <div class="flex flex-col gap-gutter">
        <p class="t-h6 text-ink">{MEGA.articles.sideHeading}</p>
        <ul class="flex flex-col gap-gutter">
          <li>
            <a href={MEGA.articles.viewAll.href} class={`${link} inline-flex items-center gap-2`}>
              {MEGA.articles.viewAll.label}
              <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="size-[18px]" />
            </a>
          </li>
          {MEGA.articles.sideLinks.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Blue wash over the page below an open menu (#0059FF at 60%). Click or move onto it to close. -->
  <div data-mega-backdrop hidden aria-hidden="true" class="h-screen bg-blue/60"></div>
</div>
