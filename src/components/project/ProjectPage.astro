---
// A project page outside Shopify (Dyson, Wrangler, the identity work on the branding page), laid out like
// a case study: the hero (photo to the centre line, headline beside it), the brief beside the facts, then
// the work as labelled rows of images in page order, the best Shopify work and the form.
// Each image keeps its own shape. Wide images run two a row (one if alone); tall and square ones up to
// three a row (half the width if alone), so nothing is cropped. Data in src/data/projects.ts.
import Base from '../../layouts/Base.astro';
import Schema from '../Schema.astro';
import Header from '../Header.astro';
import Heading from '../Heading.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import Media from '../case-study/Media.astro';
import Contact from '../home/Contact.astro';
import { SITE } from '../../data/site';
import type { ProjectPageData, ProjectRow } from '../../data/project-types';
import TextLink from '../TextLink.astro';
import { card } from '../../data/case-studies/types';
import { URLS } from '../../data/site';

interface Props { data: ProjectPageData }
const { data: d } = Astro.props;

const url = new URL(d.meta.path, SITE).href;
const clientId = `${url}#client`;
const client = { '@type': 'Organization', '@id': clientId, name: d.client };

const heroImg = d.hero.image.image;
const heroSizes = heroImg && heroImg.width > heroImg.height ? '100vw' : '(min-width: 1024px) 50vw, 100vw';

const wide = (m: ProjectRow['items'][number]) => !!m.media.image && m.media.image.width > m.media.image.height * 1.05;
const layout = (r: ProjectRow) => {
  const n = r.items.length;
  // Display adverts at their real size: 300px wide on desktop, two a row on phones.
  if (r.adSize) return { grid: 'flex flex-wrap', cell: 'w-[calc((100%-var(--spacing-grid))/2)] sm:w-[300px]', sizes: '(min-width: 640px) 300px, 50vw' };
  const allWide = r.items.every(wide);
  if (n === 1) return { grid: 'grid-cols-1', cell: allWide ? '' : 'lg:w-half', sizes: allWide ? '100vw' : '(min-width: 1024px) 50vw, 100vw' };
  if (allWide) return { grid: 'grid-cols-1 sm:grid-cols-2', cell: '', sizes: '(min-width: 640px) 50vw, 100vw' };
  return { grid: n === 2 || n === 4 ? 'grid-cols-2' : 'grid-cols-2 lg:grid-cols-3', cell: '', sizes: n === 2 || n === 4 ? '50vw' : '(min-width: 1024px) 33vw, 50vw' };
};

// The best Shopify work, so every project page leads back to what I design now (1 November 2026):
// the top three of the homepage five.
const shopify = ['Drink Finder', 'East at Home', 'Fuzzball'].map(card);


const meta = 'font-display font-medium text-[14px] leading-[1.3] tracking-[0.02em]';
---
<Base title={d.meta.title} description={d.meta.description} ogImage={heroImg}>
  <Schema slot="head" title={d.meta.title} description={d.meta.description} path={d.meta.path} breadcrumbs={d.meta.breadcrumbs} about={clientId} extra={[client]} />
  <Header overlay />
  <main id="main">
    <!-- Hero, as the case studies: photo from the left screen edge to the centre line, a screen tall on desktop -->
    <section class="lg:grid lg:min-h-[calc(100dvh-var(--bar-h,0px))] lg:grid-cols-2 lg:gap-gutter">
      <div data-header-image class="relative lg:h-full lg:min-h-[calc(100dvh-var(--bar-h,0px))]">
        <Media media={d.hero.image} fit="cover" sizes={heroSizes} eager class="aspect-[4/3] w-full lg:absolute lg:inset-0 lg:aspect-auto lg:h-full" />
        <div class="absolute inset-0 hidden bg-[linear-gradient(to_bottom,rgba(0,0,0,0.35)_0%,rgba(0,0,0,0)_21%)] lg:block" aria-hidden="true"></div>
      </div>
      <div class="px-margin pt-margin lg:flex lg:flex-col lg:pl-0 lg:pt-[124px]">
        <div class="lg:flex lg:flex-1 lg:flex-col lg:justify-center lg:border-t lg:border-line lg:py-section lg:pr-[15px]">
          <Heading level={1} eyebrow={d.hero.eyebrow}>{d.hero.heading}</Heading>
          <p class="t-body mt-loose text-muted">{d.hero.standfirst}</p>
        </div>
      </div>
    </section>

    <!-- The brief, and the project facts -->
    <section class="px-margin pt-section lg:pt-[120px]">
      <div class="flex flex-col gap-large border-t border-line pt-section lg:flex-row lg:gap-gutter lg:border-t-0 lg:pt-0">
        <div class="flex-1">
          <Heading eyebrow={d.brief.eyebrow} deco={false}>{d.brief.heading}</Heading>
          <div class="t-body mt-loose flex flex-col gap-[10px] text-muted">
            {d.brief.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <dl class:list={[meta, 'flex flex-col gap-loose border-t border-line pt-large lg:w-[calc(50%+var(--page-gutter)/2)] lg:shrink-0 lg:border-l lg:border-t-0 lg:pl-gutter lg:pt-0']}>
          {d.facts.map((f) => (
            <div class="flex gap-2"><dt class="w-[120px] shrink-0 text-[#c4c4c4]">{f.label}</dt><dd class="flex-1 text-ink">{f.value}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- The work: each project (when there are two) then its rows -->
    {d.groups.map((g) => (
      <>
        {g.heading && (
          <section id={g.id} class="scroll-mt-6 px-margin pt-section lg:pt-[120px]">
            <div class="grid gap-loose border-t border-line pt-section lg:grid-cols-2 lg:gap-gutter">
              <Heading eyebrow={g.eyebrow}>{g.heading}</Heading>
              <div class="t-body flex flex-col justify-end gap-[10px] text-muted">{g.body?.map((p) => <p>{p}</p>)}</div>
            </div>
          </section>
        )}
        {g.rows.map((r) => {
          if (r.logo) return (
            <section class="px-margin pt-section">
              <h3 class="t-h6 text-ink">{r.label}</h3>
              <div class="mt-loose flex justify-center py-section">
                <img src={r.logo.src} alt={r.logo.alt} width={r.logo.width} height={r.logo.height} loading="lazy" decoding="async" class="h-auto max-h-[60vh] w-[80%] object-contain lg:w-[60%]" />
              </div>
            </section>
          );
          const l = layout(r);
          return (
            <section class="px-margin pt-section">
              <h3 class="t-h6 text-ink">{r.label}</h3>
              <ul class:list={['mt-loose items-start gap-grid', r.adSize ? '' : 'grid', l.grid]}>
                {r.items.map((it) => {
                  const img = it.media.image;
                  return (
                    <li class:list={['flex flex-col gap-3', l.cell]}>
                      <div style={img ? `aspect-ratio:${img.width}/${img.height}` : 'aspect-ratio:16/10'}>
                        <Media media={it.media} fit="cover" sizes={l.sizes} class="size-full" />
                      </div>
                      {it.caption && <p class="t-small text-muted">{it.caption}</p>}
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })}
      </>
    ))}

    <!-- Back to the Shopify work: on phones one large card, then two smaller (as the case studies) -->
    <section class="px-margin pt-section pb-section lg:pt-[120px]">
      <div class="border-t border-line pt-section">
        <div class="lg:flex lg:items-end lg:justify-between lg:gap-gutter">
          <div class="lg:w-half lg:shrink-0"><Heading eyebrow="Shopify success stories">What I design now: stores that sell.</Heading></div>
          <div class="mt-loose lg:mt-0"><TextLink href={URLS.work}>View all Shopify success stories</TextLink></div>
        </div>
        <ul class="cards-align mt-gutter grid grid-cols-2 gap-x-grid [--cards-gap:var(--spacing-grid-lg)] lg:grid-cols-3">
          {shopify.map((c, i) => (
            <li class:list={[i === 0 && 'col-span-2 lg:col-span-1']}>
              <CaseStudyCard {...c} ratio={i === 0 ? 'square-portrait' : 'portrait'} stackMeta={i > 0} sizes={i === 0 ? '(min-width: 1024px) 31vw, calc(100vw - 32px)' : '(min-width: 1024px) 31vw, calc(50vw - 24px)'} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div>
      <Contact heading={d.enquiry} />
    </div>
  </main>
</Base>
