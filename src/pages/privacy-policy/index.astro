---
// Privacy and cookie notice. Plain, first person, and only what actually happens on this site:
// the enquiry form (worker/enquiry.js, sent through Resend), analytics only after Accept
// (ConsentBanner.astro, GA4 through Cloudflare Zaraz) and Cloudflare hosting.
// Draft, 29 October 2026. [CONFIRM] notes mark the facts only Anthony can give.
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import { URLS, ENTITY } from '../../data/site';

const P = {
  path: URLS.privacy,
  title: 'Privacy and Cookies | Anthony is Freelance',
  description: 'How Anthony is Freelance handles your details: what the enquiry form collects, the analytics cookies used only if you accept, and your rights.',
  eyebrow: 'Privacy and cookies',
  heading: 'What I collect, why, and what you can ask for.',
  intro: 'This site collects very little. The enquiry form sends me what you type, and analytics only run if you accept cookies.',
  updated: { iso: '2026-10-29', label: '29 October 2026' },
};
const { business } = ENTITY;
const mail = `mailto:${business.email}`;
---
<Base title={P.title} description={P.description}>
  <Schema
    slot="head"
    title={P.title}
    description={P.description}
    path={P.path}
    about={ENTITY.business.id}
    breadcrumbs={[{ name: 'Home', path: URLS.home }, { name: 'Privacy and cookies', path: P.path }]}
  />
  <Header />
  <main id="main">
    <PageHero eyebrow={P.eyebrow} heading={P.heading} intro={P.intro}>
      <p class="t-label tracking-[0.02em] text-muted">Updated <time datetime={P.updated.iso}>{P.updated.label}</time></p>
    </PageHero>

    <section class="px-margin py-section">
      <div class="prose-article lg:w-half">
        <h2>Who I am</h2>
        <p>
          This site belongs to {business.legalName}, trading as {business.name}, registered in England and Wales
          (company number {business.companyNumber}) and based in {business.locality}, {business.region}. I'm Anthony Bliss,
          the director, and I decide how your details are used. You can reach me at <a href={mail}>{business.email}</a>.
        </p>
        <!-- [CONFIRM] ICO registration number, if registered: "Registered with the ICO, number ZA000000." -->

        <h2>The enquiry form</h2>
        <p>
          When you send the form, I receive your name, email, website, budget, message and how you found me. I use them to
          reply to you and, if we work together, to run the project. Nothing goes on a mailing list, and I never sell or share
          it for marketing.
        </p>
        <p>
          The form is sent to my inbox through Resend, an email delivery service. If you email me directly, the same applies.
        </p>
        <p>
          I keep enquiries that don't become projects for [CONFIRM: two years], then delete them. Client records are kept for
          six years, because UK company and tax law requires it.
        </p>

        <h2 id="cookies">Cookies and analytics</h2>
        <p>
          Analytics cookies only load if you press Accept on the cookie banner. They tell me which pages people visit, how
          they found the site and what device they used, so I can improve it. I use Google Analytics, loaded through
          Cloudflare Zaraz. Google Analytics doesn't give me your name or contact details.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Name</th><th>What it does</th><th>How long</th></tr>
            </thead>
            <tbody>
              <tr><td>aif-consent (browser storage, not a cookie)</td><td>Remembers whether you accepted or rejected analytics</td><td>Six months</td></tr>
              <tr><td>_ga, _ga_*</td><td>Google Analytics: tells visits apart. Only set after Accept</td><td>Up to two years</td></tr>
              <tr><td>__cf_bm</td><td>Cloudflare: stops automated attacks. Needed for the site to work safely</td><td>30 minutes</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          You can change your mind any time with Cookie settings at the bottom of every page. Analytics data is kept for
          [CONFIRM: 14 months].
        </p>

        <h2>Who else handles your details</h2>
        <ul>
          <li>Cloudflare hosts the site, protects it from attacks and runs Zaraz.</li>
          <li>Resend delivers the enquiry form to my inbox.</li>
          <li>Google provides the analytics, only if you accept.</li>
          <li>[CONFIRM: my email provider] holds my inbox.</li>
        </ul>
        <p>
          Some of these companies store data outside the UK. When they do, they use the safeguards UK data protection law
          approves.
        </p>

        <h2>Why I'm allowed to use it</h2>
        <p>
          Replying to an enquiry and running a project are steps towards, or part of, a contract with you. Analytics rely on
          your consent, which you can withdraw. Keeping client records rests on a legal obligation.
        </p>

        <h2>Your rights</h2>
        <p>
          You can ask me for a copy of your details, ask me to correct or delete them, object to how I use them, or ask me to
          stop. Email <a href={mail}>{business.email}</a> and I'll reply within one month.
        </p>
        <p>
          If you're unhappy with how I've handled your details, you can complain to the Information Commissioner's Office at{' '}
          <a href="https://ico.org.uk/make-a-complaint/">ico.org.uk</a> or on 0303 123 1113. I'd appreciate the chance to put
          it right first.
        </p>
      </div>
    </section>
  </main>
</Base>
