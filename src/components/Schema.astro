---
// Builds one @graph per page from the shared entity data. Pages pass their own bits.
import { ENTITY, SITE, URLS } from '../data/site';
import { getImage } from 'astro:assets';
import portrait from '../assets/site/anthony-about-hero.jpg';
// Anthony's photo for the Person entity, the same picture as the About page.
const photo = await getImage({ src: portrait, width: 800, format: 'jpg', quality: 80 });
const photoUrl = new URL(photo.src, SITE).href;
const logoUrl = new URL('/icon-512.png', SITE).href;
const awards = ENTITY.awards;
const knowsAbout = ENTITY.person.knowsAbout.map((k) => ({ '@type': 'Thing', ...k }));

interface Props {
  type?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage' | 'ProfilePage';
  /** Carry the full Person (the About page is his profile page). The full business stays on the homepage only. */
  fullPerson?: boolean;
  title: string;
  description: string;
  path: string;
  faqs?: { q: string; a: string[]; checked?: string }[];
  isHome?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  /** Extra nodes for this page (OfferCatalog, ItemList...), built from data, never hand-written. */
  extra?: Record<string, unknown>[];
  mainEntity?: string; // @id of the page's main entity
  about?: string; // @id of what the page is about, when it isn't the business
  /** Extra properties on this page's own node (mentions, citation, dateModified), from data. */
  page?: Record<string, unknown>;
}
const { type = 'WebPage', title, description, path, faqs, isHome = false, fullPerson = false, breadcrumbs, extra = [], mainEntity, about, page = {} } = Astro.props;
const url = new URL(path, SITE).href;
const b = ENTITY.business;

const person = {
  '@type': 'Person',
  '@id': ENTITY.person.id,
  name: ENTITY.person.name,
  jobTitle: ENTITY.person.jobTitle,
  // The About page is his profile page; the same on every page that carries this @id.
  url: new URL(URLS.about, SITE).href,
  worksFor: { '@id': b.id },
  alumniOf: ENTITY.person.alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  image: photoUrl,
  description: ENTITY.person.description,
  knowsAbout,
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Shopify designer',
    occupationLocation: { '@type': 'Country', name: 'United Kingdom' },
    skills: ENTITY.person.skills.join(', '),
  },
  award: awards,
  homeLocation: { '@type': 'Place', name: `${b.locality}, ${b.region}` },
  sameAs: ENTITY.sameAs,
};

const business = {
  '@type': 'ProfessionalService',
  '@id': b.id,
  name: b.name,
  legalName: b.legalName,
  alternateName: b.alternateName,
  url: SITE + '/',
  logo: logoUrl,
  image: photoUrl,
  description: b.description,
  foundingDate: b.foundingDate,
  priceRange: b.priceRange,
  knowsAbout,
  award: awards,
  // The full price list lives on the services page as an OfferCatalog under this @id.
  hasOfferCatalog: { '@id': new URL(URLS.services, SITE).href + '#catalog' },
  telephone: b.telephone,
  email: b.email,
  founder: { '@id': ENTITY.person.id },
  address: { '@type': 'PostalAddress', addressLocality: b.locality, addressRegion: b.region, addressCountry: b.country },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  identifier: { '@type': 'PropertyValue', propertyID: 'Companies House', value: b.companyNumber },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: b.hours.days, opens: b.hours.opens, closes: b.hours.closes },
  sameAs: ENTITY.sameAs,
};

const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': ENTITY.website.id, url: SITE + '/', name: ENTITY.website.name, publisher: { '@id': b.id }, inLanguage: 'en-GB' },
  {
    '@type': type,
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': ENTITY.website.id },
    about: { '@id': about ?? (isHome ? ENTITY.person.id : b.id) },
    author: { '@id': ENTITY.person.id },
    inLanguage: 'en-GB',
    ...(breadcrumbs ? { breadcrumb: { '@id': `${url}#breadcrumb` } } : {}),
    ...(mainEntity ? { mainEntity: { '@id': mainEntity } } : {}),
    ...page,
  },
];

if (breadcrumbs) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE).href })),
  });
}
graph.push(...extra);

// Full entity definitions live on the homepage. Every other page carries a short version under the
// same @id (who they are, not everything about them): Google doesn't follow an @id to another page,
// so an article's author needs a name on the article itself.
// Google asks for the business on the homepage or one page about it, so the full business lives on the
// homepage only. The About page is Anthony's profile page, so it carries the full Person.
const personShort = { '@type': 'Person', '@id': person['@id'], name: person.name, jobTitle: person.jobTitle, url: person.url, sameAs: person.sameAs };
// Inner pages name the business as a plain Organization (same @id), so Google doesn't read every page
// as a local business listing and ask for an address on each one.
const businessShort = { '@type': 'Organization', '@id': business['@id'], name: business.name, url: business.url, logo: logoUrl };
if (isHome) graph.push(person, business);
else graph.push(fullPerson ? person : personShort, businessShort);

if (faqs?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      // Word for word with the page, including any "Checked" line.
      acceptedAnswer: { '@type': 'Answer', text: [...f.a, f.checked].filter(Boolean).join(' ').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') },
    })),
  });
}

// Google wants schema dates as full date-times with a time zone (Rich Results Test, 3 November 2026).
// Data keeps plain dates; here each one becomes 9am UK time on that day, with the right GMT or BST offset.
const ukDateTime = (d: string) => {
  const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', timeZoneName: 'shortOffset' })
    .formatToParts(new Date(`${d}T12:00:00Z`)).find((x) => x.type === 'timeZoneName')?.value ?? 'GMT';
  const h = off === 'GMT' ? 0 : Number(off.replace('GMT', ''));
  return `${d}T09:00:00${h >= 0 ? '+' : '-'}${String(Math.abs(h)).padStart(2, '0')}:00`;
};
const fixDates = (o: unknown): unknown => {
  if (Array.isArray(o)) return o.map(fixDates);
  if (o && typeof o === 'object') {
    return Object.fromEntries(Object.entries(o as Record<string, unknown>).map(([k, v]) =>
      [k, (k === 'datePublished' || k === 'dateModified') && typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? ukDateTime(v) : fixDates(v)]));
  }
  return o;
};
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': fixDates(graph) });
---
<script type="application/ld+json" set:html={json} />
