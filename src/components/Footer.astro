---
// Desktop: columns. Mobile: the same columns as an accordion.
// Columns start open (the no-JS fallback); a few lines close them on phones.
import { FOOTER_COLUMNS, SOCIAL, URLS, ENTITY } from '../data/site';
const year = new Date().getFullYear();
const columns = [
  ...FOOTER_COLUMNS,
  {
    title: 'Get in touch',
    links: [
      { label: 'About', href: URLS.about },
      { label: 'Contact', href: URLS.contact },
      { label: ENTITY.business.telephoneDisplay, href: `tel:${ENTITY.business.telephoneDisplay}`, underline: true },
      { label: ENTITY.business.email, href: `mailto:${ENTITY.business.email}`, underline: true },
    ],
  },
];
---
<footer class="pt-section lg:pt-section-sm">
  <div class="flex flex-col gap-grid-lg bg-surface px-margin pb-[92px] lg:items-center lg:gap-[80px] lg:px-0 lg:pb-large lg:pt-[80px]">
    <img src="/icons/wordmark.svg" alt="Anthony Bliss, Anthony is Freelance" width="1392" height="94" class="h-auto w-full lg:w-[calc(100%-2*var(--page-margin))]" loading="lazy" />

    <div class="flex w-full flex-col gap-grid-lg lg:gap-large">
      <div class="lg:px-margin">
        <div class="flex flex-col gap-grid-lg lg:flex-row lg:justify-between lg:gap-0 lg:border-b lg:border-line lg:pb-[80px]">
          <div class="order-2 flex flex-col gap-2 border-y border-line py-3 lg:order-none lg:w-[197px] lg:gap-loose lg:border-0 lg:py-0">
            <p class="t-label flex items-center gap-2 tracking-[0.02em] text-ink">
              <img src="/icons/google-g.png" alt="Google" width="25" height="25" class="size-[25px]" loading="lazy" />
              <span>★★★★★ 5/5</span>
            </p>
            <p class="t-label tracking-[0.02em] text-ink">2× winner, UK eCommerce Awards 2026</p>
          </div>
          <div class="order-1 flex flex-col lg:order-none lg:contents">
            {columns.map((col, i) => (
              <details open data-footer-col class:list={['group lg:w-[198px]', i < columns.length - 1 && 'border-b border-line lg:border-0']}>
                <summary class="t-badge flex h-[50px] items-center justify-between text-ink lg:pointer-events-none lg:mb-loose lg:h-auto lg:text-muted">
                  {col.title}
                  <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:rotate-45 lg:hidden" />
                </summary>
                <ul class="flex flex-col gap-4 pb-loose lg:pb-0">
                  {col.links.map((l) => (
                    <li><a href={l.href} class:list={['t-label text-ink link-hover', 'underline' in l && l.underline && 'underline hover:decoration-2']}>{l.label}</a></li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-grid-lg lg:items-center lg:gap-large lg:px-margin">
        <ul class="flex items-center gap-3 lg:gap-4">
          {SOCIAL.map((s) => (
            <li><a href={s.href} aria-label={s.label}><img src={s.icon} alt="" width="24" height="24" class="size-6" loading="lazy" /></a></li>
          ))}
        </ul>
        <p class="t-label flex flex-col gap-[10px] tracking-[0.02em] text-muted lg:flex-row lg:items-center lg:gap-10">
          <span class="lg:order-1">Registered in England &amp; Wales No. {ENTITY.business.companyNumber}</span>
          <span class="lg:order-2">VAT number 530 0230 61</span>
          <span class="lg:order-3">Based in Falmouth, Cornwall, UK.</span>
          <span class="mt-[6px] lg:order-first lg:mt-0">© {year} Anthony is Freelance</span>
        </p>
      </div>
    </div>
  </div>
</footer>
<script is:inline>
  // Collapse the footer columns into an accordion on phones.
  if (window.matchMedia('(max-width: 1023px)').matches) {
    document.querySelectorAll('[data-footer-col]').forEach(function (d) { d.open = false; });
  }
</script>
