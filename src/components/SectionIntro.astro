---
// Section header used across the page: heading, optional intro, links to the right on desktop.
import Heading from './Heading.astro';
interface Props {
  eyebrow: string;
  heading: string;
  deco?: boolean;
  split?: boolean; // links sit bottom-right on desktop
  class?: string;
}
const { eyebrow, heading, deco = true, split = true, class: className = '' } = Astro.props;
const hasLinks = Astro.slots.has('links');
const hasIntro = Astro.slots.has('intro');
---
<div class:list={[split ? 'lg:flex lg:items-end lg:justify-between lg:gap-gutter' : '', className]}>
  <div class:list={['flex flex-col gap-loose', split ? 'lg:w-[676px] lg:max-w-[48%]' : '']}>
    <Heading eyebrow={eyebrow} deco={deco} >{heading}</Heading>
    {hasIntro && <div class="t-body text-muted"><slot name="intro" /></div>}
    {hasLinks && !split && <div class="flex flex-wrap gap-x-grid gap-y-4"><slot name="links" /></div>}
  </div>
  {hasLinks && split && (
    <div class="mt-loose flex flex-col items-start gap-4 lg:mt-0 lg:flex-row lg:flex-wrap lg:justify-end lg:gap-x-grid"><slot name="links" /></div>
  )}
</div>
