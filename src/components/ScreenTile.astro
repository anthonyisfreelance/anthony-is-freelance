---
// A phone screen standing in a softly blurred copy of itself, as in the Figma innovation tiles.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  screen: ImageMetadata;
  backdrop?: ImageMetadata; // defaults to the screen itself
  alt?: string;
  inset?: string; // horizontal inset of the phone, as a percentage of the tile
  sizes?: string;
  class?: string;
}
const { screen, backdrop, alt = '', inset = '24.5%', sizes = '(min-width: 1024px) 15vw, 40vw', class: className = '' } = Astro.props;
---
<div class:list={['relative aspect-square overflow-hidden bg-white', className]}>
  <div class="absolute inset-0 scale-125 blur-[60px]" aria-hidden="true">
    {backdrop && <Image src={backdrop} alt="" width={200} class="absolute left-0 top-[-69.62%] h-[172.86%] w-full max-w-none" />}
    <Image src={screen} alt="" width={200} class="absolute inset-0 size-full object-cover" />
  </div>
  <div class="absolute inset-0 bg-white/20"></div>
  <div class="absolute bottom-0 aspect-[216/376] overflow-hidden" style={`left:${inset};right:${inset}`}>
    <Image src={screen} alt={alt} widths={[220, 440, 660]} sizes={sizes} class="zoom-img size-full object-cover object-top" />
  </div>
</div>
