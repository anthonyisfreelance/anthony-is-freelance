---
// Full case study card (work page and service page proof sections):
// photo and the store's UI side by side, client · sector row, claim, proof line.
import { Image } from 'astro:assets';
import ScreenTile from './ScreenTile.astro';
import type { CaseStudy } from '../data/work';
interface Props { study: CaseStudy; eager?: boolean; level?: 2 | 3 }
const { study: s, eager = false, level = 3 } = Astro.props;
const H = `h${level}`;
// Crop to the frame's ratio at build time, so phones don't download the hidden part of a portrait photo.
const ratio = 5 / 4;
const w = s.image ? Math.min(1400, s.image.width, Math.round(s.image.height / ratio)) : 0;
const widths = [360, 560, 720, 1000, 1400].filter((x) => x < w).concat(w);
const sizes = '(min-width: 1024px) 24vw, 50vw';
---
<article class="hover-card relative flex flex-col" data-services={s.services.join(' ')}>
  <div class="grid grid-cols-2 gap-[2px]">
    <div class="relative aspect-[4/5] overflow-hidden bg-line">
      {s.image ? (
        <Image src={s.image} alt="" width={w} height={Math.round(w * ratio)} fit="cover" widths={widths} sizes={sizes} quality={75} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="zoom-img absolute inset-0 size-full object-cover" />
      ) : (
        <span class="t-badge absolute inset-0 grid place-items-center text-muted">[Image to come]</span>
      )}
      {s.badge && (
        <div class="absolute left-0 top-0 h-20 bg-surface p-3">
          <Image src={s.badge} alt={s.badgeAlt ?? ''} height={56} densities={[1, 2]} class="h-full w-auto" />
        </div>
      )}
    </div>
    {s.screen ? (
      <div aria-hidden="true"><ScreenTile screen={s.screen} ratio="portrait" sizes="(min-width: 1024px) 15vw, 30vw" /></div>
    ) : (
      <div class="relative aspect-[4/5] bg-line" aria-hidden="true">
        <span class="t-badge absolute inset-0 grid place-items-center text-muted">[Screen to come]</span>
      </div>
    )}
  </div>
  <p class="t-badge flex gap-2 border-b border-line py-3 text-muted" aria-hidden="true">
    <span class="flex-1">{s.client}</span><span class="flex-1 text-right">{s.meta}</span>
  </p>
  <H class="t-h6 mt-3 text-ink">
    {s.href ? <a href={s.href} class="stretched-link link-hover"><span class="sr-only">{s.client}. </span>{s.claim}</a> : <><span class="sr-only">{s.client}. </span>{s.claim}</>}
  </H>
  <p class="sr-only">{s.meta}</p>
  <p class="t-label mt-3 border-t border-line pt-2 tracking-[0.02em] text-muted">{s.proof}</p>
</article>
