---
// Footer (Figma "Footers" 53:1162: Desktop 47784:3107, Mobile 47782:2811; feedback #265, 29 October 2026).
// Updated 29 October 2026 evening: the wordmark leads at every size.
// Desktop: the wordmark, five columns (Services, Work, Articles, Get in touch, Social) under H5 headings,
// the rating and awards tiles, then one centred line of company details.
// Phones: the wordmark, the columns as an accordion, the tiles side by side, then the company details.
// Columns start open (the no-JS fallback); a few lines close them on phones.
import TrustTiles from './TrustTiles.astro';
import { FOOTER_COLUMNS, SOCIAL, URLS, ENTITY, GOOGLE_RATING } from '../data/site';
const year = new Date().getFullYear();
type Col = { title: string; links: { label: string; href: string; underline?: boolean; external?: boolean }[] };
const columns: Col[] = [
  ...FOOTER_COLUMNS,
  {
    title: 'Get in touch',
    links: [
      { label: 'About', href: URLS.about },
      { label: 'Contact', href: URLS.contact },
      { label: ENTITY.business.telephoneDisplay, href: `tel:${ENTITY.business.telephone}`, underline: true },
      { label: ENTITY.business.email, href: `mailto:${ENTITY.business.email}`, underline: true },
    ],
  },
  // Named text links, not icons, so each one tells people and crawlers what it is.
  { title: 'Social', links: SOCIAL.map((s) => ({ ...s, external: true })) },
];
const bar = 'hidden lg:inline';
---
<!-- Phones keep 92px clear at the bottom for the sticky Start a project bar. -->
<footer class="bg-surface px-margin pb-[92px] pt-[64px] lg:pb-[80px] lg:pt-[120px]">
  <img src="/icons/wordmark.svg" alt="Anthony Bliss, Anthony is Freelance" width="1392" height="94" class="mb-[36px] h-auto w-full lg:mb-[80px]" loading="lazy" />

  <div class="flex flex-col lg:flex-row lg:justify-between">
    {columns.map((col, i) => (
      <details open data-footer-col class:list={['group lg:w-[198px]', i < columns.length - 1 && 'border-b border-line lg:border-0']}>
        <summary class="t-h5 flex h-[58px] items-center justify-between uppercase text-ink lg:pointer-events-none lg:mb-loose lg:h-auto lg:text-muted">
          {col.title}
          <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:rotate-45 lg:hidden" />
        </summary>
        <ul class="flex flex-col gap-4 pb-loose lg:pb-0">
          {col.links.map((l) => (
            <li>
              <a
                href={l.href}
                {...(l.external ? { target: '_blank', rel: 'noopener me' } : {})}
                class:list={['t-label text-ink link-hover', l.underline && 'underline hover:decoration-2']}
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>

  <TrustTiles
    equal
    label="Reviews and awards"
    class="mt-[40px] lg:mt-[80px] lg:gap-loose!"
    items={[GOOGLE_RATING, { text: '2× winner, UK eCommerce Awards 2026' }]}
  />

  <p class="t-tile mt-8 flex flex-col gap-[12px] text-muted lg:mt-[40px] lg:flex-row lg:flex-wrap lg:justify-center lg:gap-x-3 lg:gap-y-1">
    <span class="max-lg:order-last max-lg:mt-[6px]">© {year} Anthony is Freelance</span>
    <span aria-hidden="true" class={bar}>|</span>
    <span>Registered in England &amp; Wales No. <a href={ENTITY.companiesHouse} target="_blank" rel="noopener" class="underline underline-offset-4 hover:decoration-2">{ENTITY.business.companyNumber}</a></span>
    <span aria-hidden="true" class={bar}>|</span>
    <span>VAT number 530 0230 61</span>
    <span aria-hidden="true" class={bar}>|</span>
    <span>Based in Falmouth, Cornwall, UK.</span>
    <span aria-hidden="true" class={bar}>|</span>
    <span class="flex gap-x-3">
      <a href={URLS.privacy} class="link-hover">Privacy and cookies</a>
      <span aria-hidden="true">|</span>
      <button type="button" data-consent-open class="cursor-pointer text-left link-hover">Cookie settings</button>
    </span>
  </p>
</footer>
<script is:inline>
  // Collapse the footer columns into an accordion on phones.
  if (window.matchMedia('(max-width: 1023px)').matches) {
    document.querySelectorAll('[data-footer-col]').forEach(function (d) { d.open = false; });
  }
</script>
