---
import SectionIntro from '../SectionIntro.astro';
import TextLink from '../TextLink.astro';
import ArticleCard from '../ArticleCard.astro';
import { ARTICLES } from '../../data/home';
import { ARTICLES_LIST } from '../../data/articles';
---
<section class="px-margin pt-section-sm lg:pt-section-pre">
  <div class="border-t border-line pt-section">
    <SectionIntro eyebrow={ARTICLES.eyebrow} heading={ARTICLES.heading}>
      <TextLink slot="links" href={ARTICLES.link.href}>{ARTICLES.link.label}</TextLink>
    </SectionIntro>
    <ul class="mt-grid-lg grid grid-cols-2 gap-x-grid gap-y-large lg:grid-cols-4">
      {ARTICLES_LIST.slice(0, 4).map((a) => <li><ArticleCard article={a} excerpt={false} /></li>)}
    </ul>
  </div>
</section>
