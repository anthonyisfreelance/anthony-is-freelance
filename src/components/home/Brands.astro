---
import Heading from '../Heading.astro';
import { BRANDS } from '../../data/home';
---
<section class="px-margin pt-section-sm lg:pt-section-pre">
  <div class="gap-gutter border-t border-line pt-section lg:flex lg:pt-section-sm">
    <div class="flex flex-1 flex-col gap-loose">
      <Heading eyebrow={BRANDS.eyebrow}>{BRANDS.heading}</Heading>
      <!-- Logos are images, so this line is what names the clients for search and AI tools. -->
      <p class="t-body text-muted lg:max-w-[560px]">{BRANDS.line}</p>
    </div>
    <!-- Logo files to come: names stand in for now -->
    <ul class="mt-large grid flex-1 grid-cols-4 gap-grid lg:mt-0 lg:grid-cols-5">
      {BRANDS.logos.map((name) => (
        <li class="flex h-[60px] items-center justify-center border border-dashed border-line px-1 text-center text-[11px] font-display uppercase leading-tight text-muted lg:t-badge lg:h-[100px]">{name}</li>
      ))}
    </ul>
  </div>
</section>
