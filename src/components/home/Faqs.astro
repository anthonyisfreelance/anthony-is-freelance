---
import Heading from '../Heading.astro';
import InlineLinks from '../InlineLinks.astro';
import { FAQS } from '../../data/home';
// An answer is plain paragraphs (a), or HTML with links (html) for content that comes from articles.
interface Props { data?: { eyebrow: string; heading: string; note?: string; items: { q: string; a: string[]; html?: string; checked?: string }[] } }
const { data = FAQS } = Astro.props;
---
<section class="px-margin pb-section pt-section-pre">
  <div class="grid gap-gutter border-t border-line pt-section lg:grid-cols-2">
    <div class="lg:sticky lg:top-loose lg:self-start">
      <Heading eyebrow={data.eyebrow}>{data.heading}</Heading>
      {data.note && <p class="t-label mt-loose tracking-[0.02em] text-muted">{data.note}</p>}
    </div>
    <div class="flex flex-col gap-loose">
      {data.items.map((f, i) => (
        <details class:list={['group', i > 0 && 'border-t border-line pt-loose']} open={i === 0}>
          <summary class="flex cursor-pointer items-center gap-4">
            <h3 class="t-h7 flex-1 text-ink">{f.q}</h3>
            <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:hidden" />
            <img src="/icons/minus.svg" alt="" width="18" height="18" class="hidden size-[18px] group-open:block" />
          </summary>
          <div class="t-body mt-3 flex flex-col gap-3 text-muted">
            {f.html ? <div class="prose-faq flex flex-col gap-3" set:html={f.html} /> : f.a.map((p) => <p><InlineLinks text={p} /></p>)}
            {f.checked && <p class="t-label tracking-[0.02em]">{f.checked}</p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
