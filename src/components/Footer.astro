---
// Footer (Figma "Desktop Footer" 47784:3107, feedback #265, 29 October 2026).
// Desktop: the rating and awards tiles across the top, five columns (Services, Work, Articles, Get in
// touch, Social), the wordmark, then one line of company details.
// Phones: the same order, the columns as an accordion. Columns start open (the no-JS fallback);
// a few lines close them on phones.
import TrustTiles from './TrustTiles.astro';
import { FOOTER_COLUMNS, SOCIAL, URLS, ENTITY, GOOGLE_RATING } from '../data/site';
const year = new Date().getFullYear();
type Col = { title: string; links: { label: string; href: string; underline?: boolean; external?: boolean }[] };
const columns: Col[] = [
  ...FOOTER_COLUMNS,
  {
    title: 'Get in touch',
    links: [
      { label: 'About', href: URLS.about },
      { label: 'Contact', href: URLS.contact },
      { label: ENTITY.business.telephoneDisplay, href: `tel:${ENTITY.business.telephone}`, underline: true },
      { label: ENTITY.business.email, href: `mailto:${ENTITY.business.email}`, underline: true },
    ],
  },
  // Named text links, not icons, so each one tells people and crawlers what it is.
  { title: 'Social', links: SOCIAL.map((s) => ({ ...s, external: true })) },
];
const sep = '<span aria-hidden="true" class="hidden lg:inline">|</span>';
---
<footer class="pt-section lg:pt-0">
  <div class="flex flex-col gap-section-sm bg-surface px-margin pb-[92px] pt-loose lg:gap-[120px] lg:pb-large lg:pt-[80px]">
    <div class="flex flex-col gap-section-sm lg:gap-[80px]">
      <TrustTiles
        equal
        label="Reviews and awards"
        class="lg:gap-loose!"
        items={[GOOGLE_RATING, { text: '2× winner, UK eCommerce Awards 2026' }]}
      />

      <div class="flex flex-col lg:flex-row lg:justify-between">
        {columns.map((col, i) => (
          <details open data-footer-col class:list={['group lg:w-[198px]', i < columns.length - 1 && 'border-b border-line lg:border-0']}>
            <summary class="t-h5 flex h-[50px] items-center justify-between uppercase text-ink lg:t-badge lg:pointer-events-none lg:mb-loose lg:h-auto lg:text-muted">
              {col.title}
              <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:rotate-45 lg:hidden" />
            </summary>
            <ul class="flex flex-col gap-4 pb-loose lg:pb-0">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    {...(l.external ? { target: '_blank', rel: 'noopener me' } : {})}
                    class:list={['t-label text-ink link-hover', l.underline && 'underline hover:decoration-2']}
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>

    <img src="/icons/wordmark.svg" alt="Anthony Bliss, Anthony is Freelance" width="1392" height="94" class="h-auto w-full" loading="lazy" />

    <div class="t-label flex flex-col gap-[10px] tracking-[0.02em] text-muted lg:flex-row lg:items-start lg:justify-between lg:gap-[120px]">
      <p>© {year} Anthony is Freelance</p>
      <p class="flex flex-col gap-[10px] lg:flex-row lg:flex-wrap lg:justify-end lg:gap-x-3 lg:gap-y-1 lg:text-right">
        <span>Registered in England &amp; Wales No. <a href={ENTITY.companiesHouse} target="_blank" rel="noopener" class="underline underline-offset-4 hover:decoration-2">{ENTITY.business.companyNumber}</a></span>
        <Fragment set:html={sep} />
        <span>VAT number 530 0230 61</span>
        <Fragment set:html={sep} />
        <span>Based in Falmouth, Cornwall, UK.</span>
        <Fragment set:html={sep} />
        <a href={URLS.privacy} class="self-start link-hover">Privacy and cookies</a>
        <Fragment set:html={sep} />
        <button type="button" data-consent-open class="cursor-pointer self-start text-left link-hover">Cookie settings</button>
      </p>
    </div>
  </div>
</footer>
<script is:inline>
  // Collapse the footer columns into an accordion on phones.
  if (window.matchMedia('(max-width: 1023px)').matches) {
    document.querySelectorAll('[data-footer-col]').forEach(function (d) { d.open = false; });
  }
</script>
