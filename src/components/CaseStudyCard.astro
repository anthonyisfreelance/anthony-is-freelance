---
// Compact case study card, the same on every page.
// The H3 reads "Client. Claim"; the client label is drawn visually in the top row.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  client: string;
  meta: string;
  claim: string;
  image?: ImageMetadata;
  badge?: ImageMetadata;
  badgeAlt?: string;
  href?: string;
  ratio?: 'square' | 'portrait' | 'portrait-square' | 'square-portrait';
  sizes?: string;
  stackMeta?: boolean | 'always'; // small cards stack client and sector on mobile; 'always' at every size (four-up grids)
  eager?: boolean;
  proof?: string; // service page proof sections add the proof line under the claim
}
const { client, meta, claim, image, badge, badgeAlt = '', href, ratio = 'portrait', sizes = '(min-width: 1024px) 31vw, calc(50vw - 24px)', stackMeta = false, eager = false, proof } = Astro.props;
// Space between the rows under the photo (margins, not gap, so the rows can join a parent grid's
// tracks: in a .cards-align grid every card's lines sit level with the cards beside it).
const space = stackMeta === 'always' ? 'mt-2' : stackMeta ? 'mt-2 lg:mt-3' : 'mt-3';
const aspect = { square: 'aspect-square', portrait: 'aspect-[4/5]', 'portrait-square': 'aspect-[4/5] lg:aspect-square', 'square-portrait': 'aspect-square lg:aspect-[4/5]' }[ratio];
---
<article class="hover-card relative flex flex-col">
  <div class:list={['relative overflow-hidden bg-line', aspect]}>
    {image ? <Image
      src={image}
      alt=""
      widths={[240, 360, 480, 720, 960, 1400]}
      quality={75}
      sizes={sizes}
      class="zoom-img absolute inset-0 size-full object-cover"
      loading={eager ? 'eager' : 'lazy'}
    /> : <span class="t-badge absolute inset-0 grid place-items-center text-muted">[Image to come]</span>}
    {badge && (
      <div class="absolute left-0 top-0 h-20 bg-surface p-3">
        <Image src={badge} alt={badgeAlt} height={56} densities={[1, 2, 3]} format="png" class="h-full w-auto" />
      </div>
    )}
  </div>
  <div class="card-body flex flex-col">
    <p
      class:list={[
        't-badge flex border-b border-line text-muted',
        stackMeta === 'always' ? 'flex-col gap-1 py-2' : stackMeta ? 'flex-col gap-1 py-2 lg:flex-row lg:gap-2 lg:py-3' : 'gap-2 py-3',
      ]}
      aria-hidden="true"
    >
      <span class="shrink-0">{client}</span>
      <span class:list={['min-w-0 flex-1', stackMeta === 'always' ? '' : stackMeta ? 'lg:text-right' : 'text-right']}>{meta}</span>
    </p>
    <h3 class:list={['t-h6 text-ink', space]}>
      {href ? (
        <a href={href} class="stretched-link link-hover"><span class="sr-only">{client}. </span>{claim}</a>
      ) : (
        <><span class="sr-only">{client}. </span>{claim}</>
      )}
    </h3>
    <p class="sr-only">{meta}</p>
    {proof && <p class:list={['t-label border-t border-line pt-2 tracking-[0.02em] text-muted', space]}>{proof}</p>}
  </div>
</article>
