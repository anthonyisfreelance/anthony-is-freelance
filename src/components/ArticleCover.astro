---
// Article image, 16:9.
// TRIAL (23 October): three looks side by side, chosen with the switcher in Base.astro
// (?hero=live, ?hero=tile or ?hero=blue, remembered for the visit). Remove the two that lose.
// - live (default): the article's featured image from the live site.
// - tile: the dark tile on the sunken surface.
// - blue: the tile on brand blue (tile-blue.png); articles without one get the mark on blue.
// Three kinds:
// - tile (default): the article's tile from Figma ("Article tile/<slug>"), found by slug in
//   src/assets/articles/<slug>/tile.png. Falls back to the mark until the article has one.
// - mark: the category's line mark on the raised surface, no text.
// - figure: the article's headline number in blue. Falls back to the mark.
// Mark and figure sizes scale with the cover's width (container units).
import { Image } from 'astro:assets';
import { COVER_MARKS, MARK_POSITION } from '../data/article-covers';
import { articleSlug, type Article } from '../data/articles';
import { articleTile, articleLiveImage, articleBlueTile } from '../data/media';
interface Props {
  article: Article;
  /** Alt text for the live image (the article hero). Cards leave it empty: the title says it all. */
  alt?: string;
  kind?: 'tile' | 'mark' | 'figure';
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { article, alt = '', kind = 'tile', sizes = '(min-width: 1024px) 33vw, 50vw', loading = 'lazy', class: className = '' } = Astro.props;
const slug = articleSlug(article);
const tile = kind === 'tile' ? articleTile(slug) : undefined;
const figure = kind === 'figure' ? article.figure : undefined;
const trial = kind === 'tile';
const live = trial ? articleLiveImage(slug) : undefined;
const blue = trial ? articleBlueTile(slug) : undefined;
const markStyle = `left:${MARK_POSITION.left}%;top:${MARK_POSITION.top}%;width:${MARK_POSITION.width}%`;
---
{live && (
  <div class:list={['cover-live relative aspect-video overflow-hidden bg-raised', className]}>
    <Image
      src={live.image}
      alt={alt}
      widths={[400, 640, 1000, 1500, 2000]}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      class="zoom-img absolute inset-0 size-full object-cover"
    />
  </div>
)}
{trial && (
  <div class="cover-blue hidden">
    {blue ? (
      <div class:list={['relative aspect-video overflow-hidden bg-blue', className]}>
        <Image src={blue} alt="" widths={[400, 640, 960, 1400, 2000, 2400]} sizes={sizes} loading={loading} class="zoom-img absolute inset-0 size-full object-cover" />
      </div>
    ) : (
      <div class:list={['relative aspect-video overflow-hidden bg-blue', className]} aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" class="cover-mark absolute text-[#fff]" style={markStyle} set:html={COVER_MARKS[article.category]} />
      </div>
    )}
  </div>
)}
<div class={live ? 'cover-tile hidden' : 'cover-tile contents'}>
{tile ? (
  <div class:list={['relative aspect-video overflow-hidden bg-sunken', className]}>
    <Image
      src={tile}
      alt=""
      widths={[400, 640, 960, 1400, 2000, 2400]}
      sizes={sizes}
      loading={loading}
      class="zoom-img absolute inset-0 size-full object-cover"
    />
  </div>
) : (
  <div class:list={['@container relative aspect-video overflow-hidden bg-sunken', className]} aria-hidden="true">
    {figure ? (
      <>
        <p class="absolute left-[2.2cqw] top-[1.3cqw] font-display text-[34.9cqw] font-medium leading-none text-blue">{figure.value}</p>
        <p class="absolute bottom-[3.4cqw] left-[3.4cqw] font-display text-[max(11px,3.85cqw)] font-medium leading-[1.3] text-ink">{figure.label}</p>
      </>
    ) : (
      <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" class="cover-mark absolute text-ink" style={markStyle} set:html={COVER_MARKS[article.category]} />
    )}
  </div>
)}
</div>
