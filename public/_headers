# Keep workers.dev preview addresses out of Google. Never matches anthonyis.uk.
https://:prefix.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Built files carry a content hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Videos are linked with ?v=<content hash> (src/data/media.ts), so a replaced file gets a new URL.
/video/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change in place: a replaced font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and logos keep their names when edited, so a week rather than forever.
/icons/*
  Cache-Control: public, max-age=604800

/logos/*
  Cache-Control: public, max-age=604800

# The old WordPress image map the worker reads. Not a page.
/image-redirects.json
  X-Robots-Tag: noindex
