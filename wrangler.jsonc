{
  // Static site served from Cloudflare Workers static assets.
  // The worker only runs for /api/* (the form and the test-site comment tool) and the 410s; every other
  // request goes straight to the files in ./dist.
  "name": "anthony-is-freelance",
  "compatibility_date": "2026-10-18",
  "main": "./worker/index.js",
  // nodejs_compat and the browser binding are for the client documents' PDFs (worker/docs/pdf.js).
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  // Plain settings for the enquiry form (worker/enquiry.js). Kept here so a deploy never wipes them.
  // The Resend key is a secret, set in the dashboard, and secrets survive deploys.
  "vars": {
    "ENQUIRY_FROM": "Anthony is Freelance <enquiries@mail.anthonyis.uk>",
    // Sender for document codes and notices (worker/docs/mail.js).
    "DOCS_FROM": "Anthony is Freelance <documents@mail.anthonyis.uk>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      // Client quotes, contracts and invoices (worker/docs/)
      "/doc",
      "/doc/*",
      // Old WordPress images, 301 to their new copies (oldImage in worker/index.js)
      "/wp-content/uploads/*",
      // Removed pages that answer 410 (GONE in worker/index.js)
      "/portfolio/the-brand-manual*",
      "/portfolio/proconvey-video*",
      "/portfolio/inlight-beauty-shopify-case-study*",
      "/portfolio/stovefitters-shopify-case-study*",
      "/portfolio/trebah-garden*",
      "/portfolio/the-chocolate-gift-co-shopify-case-study*",
      "/portfolio/lou-coulson-associates*",
      "/portfolio/willow-stone*",
      "/portfolio/the-box*",
      "/portfolio/cloudberry*",
      // Attachment pages (map row 74): case study images one level down, demo media, and the stragglers
      "/portfolio/*/*",
      "/demo-media-*",
      "/anthony-bliss-freela2x-light*",
      "/2cfe64aa-db05-4ce3-bbfd-9f5c7243b084-2*",
      "/drink-finder-hero-2-2*",
      "/back-in-stock*",
      "/recipes-m*",
      "/red-bull*",
      "/shopify-website-design/east-west-apparel-hero_white*",
      "/1-1-christopherdaviddesign_edit-2-without-begining-frame_1080p*"
    ]
  }
}
