---
// Article template (Figma "Article", 22 October 2026). One page per file in src/data/article-content/
// (the article's blocks and FAQs); title, date and category come from the article list in
// src/data/articles.ts, so the index and the page can't disagree.
// Head: breadcrumb, category, title, byline, then the update note and standfirst when the article
// has them. Cover across the page, then contents down the left (desktop) and the article in a
// centred reading column. FAQs all open, the author, related articles.
// Body images drop in by file name (src/assets/articles/<slug>/), placeholders until then.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TextLink from '../../components/TextLink.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import ArticlesSection from '../../components/ArticlesSection.astro';
import Contact from '../../components/home/Contact.astro';
import { SITE, ENTITY, URLS } from '../../data/site';
import { ARTICLES_LIST, ARTICLES_PAGE, categoryLabel, formatDate, type Article } from '../../data/articles';
import { articleImage, versioned } from '../../data/media';
import photo from '../../assets/site/anthony.jpg';

interface Block {
  type: 'h2' | 'h3' | 'html' | 'image' | 'video';
  text?: string;
  id?: string;
  html?: string;
  /** image: file name in src/assets/articles/<slug>/. video: path under public/ (/video/articles/<slug>/…). */
  file?: string;
  alt?: string;
  /** Shown under the image or video when the live article showed it. */
  caption?: string;
  /** video: the still in src/assets/articles/<slug>/, and the video's size. */
  poster?: string;
  width?: number;
  height?: number;
}
interface Content {
  /** The full title tag, exactly as on WordPress (AIOSEO), so it doesn't change at launch. */
  seoTitle: string;
  description: string;
  published: string;
  modified: string;
  /** One or two sentences under the title. Shown only when written. */
  standfirst?: string;
  /** What changed in the last update, e.g. "Updated with the 2026 benchmarks". Shown only when written. */
  updateNote?: string;
  hero: { file: string; alt: string };
  faqHeading: string;
  blocks: Block[];
  faqs: { q: string; html: string }[];
}

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Content }>('../../data/article-content/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.json', '');
    const article = ARTICLES_LIST.find((a) => a.href === `/articles/${slug}/`)!;
    return { params: { slug }, props: { slug, article, content: mod.default } };
  });
}

const { slug, article, content: c } = Astro.props as { slug: string; article: Article; content: Content };
const url = new URL(article.href, SITE).href;
const toc = c.blocks.filter((b) => b.type === 'h2');
const words = c.blocks.reduce((n, b) => n + (b.html ?? b.text ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length, 0);
const faqs = c.faqs.map((f) => ({ q: f.q, html: f.html, a: [f.html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim()] }));
const related = [
  ...ARTICLES_LIST.filter((a) => a.href !== article.href && a.category === article.category),
  ...ARTICLES_LIST.filter((a) => a.href !== article.href && a.category !== article.category),
].slice(0, 3);
const category = categoryLabel(article.category);
const ogImage = `/og/${slug}.png`;
const crumbs = [{ name: 'Home', path: URLS.home }, { name: 'Articles', path: URLS.articles }, { name: article.title, path: article.href }];

const posting = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: article.title,
  description: c.description,
  datePublished: c.published,
  dateModified: c.modified,
  author: { '@id': ENTITY.person.id },
  publisher: { '@id': ENTITY.business.id },
  mainEntityOfPage: { '@id': `${url}#webpage` },
  image: { '@type': 'ImageObject', url: new URL(ogImage, SITE).href, width: 1200, height: 675 },
  articleSection: category,
  wordCount: words,
  inLanguage: 'en-GB',
};
const a = ARTICLES_PAGE.author;
const experience = 'Anthony Bliss has worked in design for over 20 years, from brand identity to three years at Dyson, and has been independent since August 2023.';
---
<Base title={c.seoTitle} description={c.description} image={ogImage} ogType="article">
  <Schema
    slot="head"
    title={c.seoTitle}
    description={c.description}
    path={article.href}
    about={ENTITY.person.id}
    mainEntity={`${url}#article`}
    breadcrumbs={crumbs}
    extra={[posting]}
    faqs={faqs}
  />
  <!-- TEMPORARY: colour comparison. ?look=soft (off-white body) or ?look=light (light article).
       Remove once the article colour is decided. -->
  <script is:inline slot="head">
    (() => {
      const q = new URLSearchParams(location.search);
      if (q.get('look')) document.documentElement.dataset.look = q.get('look');
    })();
  </script>
  <Header />
  <main id="main">
    <article>
      <header class="px-margin">
        <div class="flex flex-col gap-large border-t border-line pt-6 lg:pt-[40px]">
          <div class="flex flex-col gap-loose">
            <Breadcrumb items={crumbs} />
            <Heading level={1} class="lg:w-[70%]">{article.title}</Heading>
          </div>
          <div class="flex flex-col gap-6 lg:gap-[40px]">
            <!-- Byline with the category beside it on desktop, above it on phones, a hairline under both
                 (Figma 48331:13712 and 48331:14015, feedback #297). The category stays out of the H1 so the
                 H1 is the headline alone (3 Nov 2026, after the Ahrefs crawl). -->
            <div class="flex flex-col gap-4 border-b border-line pb-4 lg:w-[916px] lg:max-w-full lg:flex-row-reverse lg:items-center lg:justify-between lg:gap-[40px] lg:pb-6">
            <p class="eyebrow !mb-0" data-deco>{category}</p>
            <div class="flex items-center gap-3">
              <!-- The photo is landscape, cropped to a circle, so the file is sized by its height (#277). -->
              <Image src={photo} alt="" widths={[70, 140]} width={Math.min(140, photo.width)} sizes="70px" class="size-11 shrink-0 rounded-full object-cover" />
              <div class="t-label flex flex-col gap-1">
                <p class="text-ink">By <a href={URLS.about} rel="author" class="underline underline-offset-4 hover:decoration-2">Anthony Bliss</a>, freelance Shopify designer</p>
                <p class="text-muted">
                  Published <time datetime={c.published}>{formatDate(c.published)}</time>
                  {c.modified !== c.published && <><span aria-hidden="true">&nbsp; · &nbsp;</span>Updated <time datetime={c.modified}>{formatDate(c.modified)}</time></>}
                </p>
              </div>
            </div>
            </div>
            {c.updateNote && <p class="t-tile border-l-2 border-line pl-4 text-muted">{c.updateNote}</p>}
            {c.standfirst && <p class="font-serif text-[20px] leading-[1.6] text-ink lg:w-[66%]">{c.standfirst}</p>}
          </div>
        </div>
      </header>

      <!-- Hero: the article's image (see ArticleCover for the live image / tile trial) -->
      <figure class="mt-large px-margin">
        <ArticleCover article={article} alt={c.hero?.alt ?? ''} sizes="(min-width: 2560px) 2512px, 100vw" loading="eager" class="w-full" />
      </figure>

      <!-- Body: contents on the left (desktop), the article in a centred reading column -->
      <div class="px-margin pt-section lg:grid lg:grid-cols-12 lg:gap-x-gutter">
        <nav aria-label="Contents" class="mb-large lg:col-span-3 lg:mb-0">
          <details class="group border-y border-line lg:sticky lg:top-loose lg:border-0" open>
            <summary class="t-badge flex cursor-pointer items-center justify-between py-3 text-ink lg:pointer-events-none lg:py-0 lg:pb-loose">
              Contents
              <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:rotate-45 lg:hidden" />
            </summary>
            <ol class="flex flex-col pb-loose lg:pb-0" data-toc>
              {toc.map((h) => <li><a href={`#${h.id}`} class="t-label toc-link py-1.5">{h.text}</a></li>)}
              {faqs.length > 0 && <li><a href="#questions" class="t-label toc-link py-1.5">Frequently asked questions</a></li>}
            </ol>
          </details>
        </nav>

        <!-- From 1920 the reading column moves to the centre of the page and stops at 880px, so it
             doesn't drift right or grow too wide on big screens (#278). -->
        <div class="prose-article lg:col-span-6 lg:col-start-5 min-[1920px]:col-start-4 min-[1920px]:w-full min-[1920px]:max-w-[880px] min-[1920px]:justify-self-center">
          {c.blocks.map((b) =>
            b.type === 'h2' ? <h2 id={b.id}>{b.text}</h2>
            : b.type === 'h3' ? <h3>{b.text}</h3>
            : b.type === 'image' ? (() => {
                const img = articleImage(slug, b.file!);
                return (
                  <figure>
                    {img
                      ? <Image src={img} alt={b.caption && b.alt === b.caption ? '' : b.alt!} widths={[480, 750, 1100, 1400]} width={Math.min(1400, img.width)} sizes="(min-width: 1024px) 50vw, 100vw" class="h-auto w-full" />
                      : <div class="flex aspect-[3/2] w-full items-center justify-center bg-raised p-6"><p class="t-badge max-w-[40ch] text-center text-muted">Image to come: {b.alt}</p></div>}
                    {b.caption && <figcaption class="t-small mt-3">{b.caption}</figcaption>}
                  </figure>
                );
              })()
            : b.type === 'video' ? (() => {
                // Screen recording: the still shows first (and stays for reduced motion), the video
                // fades in over it once it's on screen. Nothing downloads until then.
                const poster = articleImage(slug, b.poster!);
                return (
                  <figure>
                    <div class="relative overflow-hidden bg-raised" style={`aspect-ratio:${b.width}/${b.height}`}>
                      {poster && <Image src={poster} alt={b.caption && b.alt === b.caption ? '' : (b.alt ?? '')} widths={[480, 750, 1100, 1280]} width={Math.min(1280, poster.width)} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 size-full object-cover" />}
                      <video
                        src={versioned(b.file!)}
                        data-autoplay
                        data-fade
                        muted
                        loop
                        playsinline
                        preload="none"
                        aria-hidden="true"
                        tabindex="-1"
                        class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300"
                      ></video>
                    </div>
                    {b.caption && <figcaption class="t-small mt-3">{b.caption}</figcaption>}
                  </figure>
                );
              })()
            : <Fragment set:html={b.html} />
          )}
        </div>
      </div>

      <!-- FAQs: every answer open, so they read as part of the article -->
      {faqs.length > 0 && (
        <section id="questions" aria-labelledby="questions-heading" class="scroll-mt-8 px-margin pt-section">
          <div class="flex flex-col gap-large border-t border-line pt-section lg:flex-row lg:gap-gutter">
            <!-- The heading stays in view while the questions scroll past (desktop). -->
            <div class="lg:sticky lg:top-loose lg:w-half lg:shrink-0 lg:self-start">
              <Heading eyebrow="Frequently asked questions" id="questions-heading">{c.faqHeading}</Heading>
            </div>
            <div class="flex flex-col gap-large lg:flex-1">
              {faqs.map((f) => (
                <div class="flex flex-col gap-3 border-t border-line pt-loose">
                  <h3 class="t-h4 text-ink">{f.q}</h3>
                  <div class="prose-faq flex flex-col gap-3 font-serif text-[18px] leading-[1.65] text-muted" set:html={f.html} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </article>

    <!-- About the author -->
    <section class="px-margin pt-section">
      <div class="grid gap-large border-t border-line pt-section lg:grid-cols-2 lg:gap-gutter">
        <!-- The byline already names Anthony, so the heading says what he does and the bio opens with his name (#282). -->
        <Heading eyebrow="About the author">Written by a freelance Shopify designer.</Heading>
        <div class="flex flex-col gap-loose sm:flex-row sm:items-start sm:gap-grid">
          <div class="relative aspect-[4/5] w-[160px] shrink-0 overflow-hidden lg:w-[180px]">
            <Image src={photo} alt="Anthony Bliss" widths={[340, 680, 1020]} width={Math.min(1020, photo.width)} sizes="(min-width: 1024px) 340px, 300px" class="absolute inset-0 size-full object-cover" />
          </div>
          <div class="flex flex-col gap-loose">
            <p class="t-h6 text-ink">{a.award}</p>
            <p class="t-body text-muted">{experience}</p>
            <div class="flex flex-wrap gap-x-grid gap-y-4">
              {a.links.map((l) => <TextLink href={l.href} external={'external' in l && l.external}>{l.label}</TextLink>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related articles: same topic first. Three on desktop, two on phones. -->
    <ArticlesSection
      articles={related}
      eyebrow="Shopify design articles"
      heading={`Related ${category} articles.`}
      class="px-margin pb-section pt-section"
    />

    <Contact />
  </main>
  <script is:inline>
    // Contents: mark the section being read (the last heading above the top fifth of the screen).
    (() => {
      const links = [...document.querySelectorAll('[data-toc] a')];
      const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter(Boolean);
      if (!targets.length) return;
      let ticking = false;
      const update = () => {
        ticking = false;
        const line = window.innerHeight * 0.2;
        let i = -1;
        targets.forEach((t, n) => { if (t.getBoundingClientRect().top <= line) i = n; });
        links.forEach((a, n) => (n === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('hashchange', update);
      update();
    })();
  </script>
</Base>
