---
// Desktop: the image sticks on the left while copy, trust row and featured story scroll.
// Mobile: solid header, square image, then everything stacked.
import Header from '../Header.astro';
import Heading from '../Heading.astro';
import TextLink from '../TextLink.astro';
import SectionIntro from '../SectionIntro.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import { HERO, STORIES } from '../../data/home';
import { URLS } from '../../data/site';
import Showreel from '../Showreel.astro';
import TrustTiles from '../TrustTiles.astro';
---
<div class="relative">
  <Header overlay />
  <div class="grid lg:grid-cols-2 lg:gap-gutter">
    <div data-header-image class="relative aspect-square w-full bg-line lg:sticky lg:top-0 lg:aspect-auto lg:h-dvh lg:self-start">
      <Showreel />
    </div>

    <div class="px-margin pt-large lg:pl-0 lg:pt-[124px]">
      <div class="flex flex-col gap-loose border-line lg:border-t lg:pt-[40px]">
        <Heading level={1} eyebrow={HERO.eyebrow}>
          {HERO.lines[0]}<br class="hidden lg:inline" /> {HERO.lines[1]}
        </Heading>
        <p class="t-body text-muted">{HERO.intro}</p>
        <div class="flex flex-wrap gap-x-grid gap-y-4">
          {HERO.ctas.map((c) => <TextLink href={c.href} data-project-open={c.href === URLS.contact ? '' : undefined}>{c.label}</TextLink>)}
        </div>
      </div>

      <TrustTiles
        equal
        class="mt-12 lg:mt-20"
        items={[{ google: true, stars: true, text: HERO.rating }, ...HERO.trust.map((text) => ({ text }))]}
      />

      <section aria-label="Success stories" class="pt-12 lg:pt-20">
        <div class="flex flex-col gap-grid-lg">
          <SectionIntro eyebrow={STORIES.eyebrow} heading={STORIES.heading} split={false}>
            <TextLink slot="links" href={STORIES.link.href}>{STORIES.link.label}</TextLink>
          </SectionIntro>
          <CaseStudyCard {...STORIES.featured} ratio="portrait-square" sizes="(min-width: 1024px) 47vw, 100vw" />
        </div>
      </section>
    </div>
  </div>

  <ul class="grid grid-cols-2 gap-x-grid gap-y-grid-lg px-margin pt-grid-lg lg:grid-cols-3 lg:pt-large">
    {STORIES.cards.map(({ mobileOnly, ...card }) => <li class:list={[mobileOnly && 'lg:hidden']}><CaseStudyCard {...card} stackMeta /></li>)}
  </ul>
</div>
