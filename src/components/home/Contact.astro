---
// The start-a-project section at the foot of pages. Pages can give it their own heading and intro.
import Heading from '../Heading.astro';
import ProjectForm from '../ProjectForm.astro';
import { CONTACT } from '../../data/home';
interface Props { eyebrow?: string; heading?: string; intro?: string }
const { eyebrow = CONTACT.eyebrow, heading = CONTACT.heading, intro } = Astro.props;
---
<section id="start-a-project" class="theme-light px-margin py-section-sm">
  <div class="flex flex-col gap-large lg:flex-row lg:gap-[160px]">
    <div class="flex flex-col gap-loose lg:w-[437px] lg:shrink-0">
      <Heading eyebrow={eyebrow}>{heading}</Heading>
      {intro && <p class="t-body text-muted">{intro}</p>}
    </div>
    <div class="flex flex-1 flex-col gap-loose">
      <ProjectForm />
      <p class="t-small text-muted">{CONTACT.reply}</p>
    </div>
  </div>
</section>
