---
// Earlier work (Dyson, Wrangler): campaign design, not Shopify proof, linked from About.
// Hero with a facts list, then one section per project: copy and what was made on the left,
// the lead image and a grid of the work on the right. Data in src/data/earlier-work.ts.
import Base from '../../layouts/Base.astro';
import Schema from '../Schema.astro';
import Header from '../Header.astro';
import PageHero from '../PageHero.astro';
import Heading from '../Heading.astro';
import TextLink from '../TextLink.astro';
import Media from '../case-study/Media.astro';
import Contact from '../home/Contact.astro';
import { URLS, ENTITY } from '../../data/site';
import { brandImage, brandVideo } from '../../data/media';
import type { EarlierWork } from '../../data/earlier-work';

interface Props { data: EarlierWork }
const { data: d } = Astro.props;
const media = (name: string, label: string, alt: string) => ({
  image: brandImage(d.brand, name),
  video: brandVideo(d.brand, name),
  alt,
  label,
});
const cols = { 2: 'grid-cols-2', 3: 'grid-cols-3', 4: 'grid-cols-2 lg:grid-cols-4' } as const;
---
<Base title={d.title} description={d.description}>
  <Schema
    slot="head"
    title={d.title}
    description={d.description}
    path={d.path}
    about={ENTITY.person.id}
    breadcrumbs={[{ name: 'Home', path: URLS.home }, { name: 'About', path: URLS.about }, { name: d.eyebrow, path: d.path }]}
  />
  <Header />
  <main id="main">
    <PageHero eyebrow={d.eyebrow} heading={d.heading} intro={d.intro}>
      <dl class="grid gap-x-gutter lg:w-half">
        {d.facts.map((f, i) => (
          <div class:list={['grid gap-1 py-3 sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-grid', i > 0 && 'border-t border-line']}>
            <dt class="t-label tracking-[0.02em] text-muted">{f.term}</dt>
            <dd class="t-body text-ink">{f.value}</dd>
          </div>
        ))}
      </dl>
    </PageHero>

    {d.projects.map((p) => (
      <section id={p.id} class="scroll-mt-6 px-margin pt-section">
        <div class="grid gap-gutter border-t border-line pt-section lg:grid-cols-2">
          <div class="flex flex-col gap-loose lg:sticky lg:top-loose lg:self-start">
            <Heading eyebrow={p.eyebrow}>{p.heading}</Heading>
            <div class="t-body flex flex-col gap-loose text-muted">
              {p.paragraphs.map((t) => <p>{t}</p>)}
            </div>
            <ul class="flex flex-col">
              {p.made.map((m, i) => (
                <li class:list={['t-label py-3 text-ink', i > 0 && 'border-t border-line']}>{m}</li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col gap-grid">
            <div style={`aspect-ratio:${p.leadAspect}`}>
              <Media
                media={media(p.leadLabel.split(':')[0], p.leadLabel, `${p.eyebrow.replace(/\.$/, '')}: ${p.leadLabel.split(': ')[1]}`)}
                fit="cover"
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="size-full"
              />
            </div>
            <div class:list={['grid gap-grid', cols[p.grid.cols]]}>
              {p.grid.labels.map((label) => {
                const name = label.split(':')[0];
                return (
                  <div style={`aspect-ratio:${p.grid.aspect}`}>
                    <Media
                      media={media(name, label, `${p.eyebrow.replace(/\.$/, '')}: ${label.split(': ')[1]}`)}
                      fit="cover"
                      sizes={p.grid.cols === 4 ? '(min-width: 1024px) 12vw, 50vw' : '(min-width: 1024px) 25vw, 50vw'}
                      class="size-full"
                    />
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="px-margin py-section">
      <div class="grid gap-gutter border-t border-line pt-section lg:grid-cols-2">
        <Heading eyebrow={d.closing.eyebrow}>{d.closing.heading}</Heading>
        <div class="flex flex-col gap-loose">
          <p class="t-body text-muted">{d.closing.text}</p>
          <div class="flex flex-wrap gap-x-large gap-y-3">
            <TextLink href={URLS.about}>Back to About</TextLink>
            <TextLink href={URLS.work}>See the Shopify work</TextLink>
          </div>
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Base>
