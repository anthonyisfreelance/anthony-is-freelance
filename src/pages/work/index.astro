---
// Case studies hub. Every card is in the HTML; filters only show and hide them.
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import WorkCard from '../../components/WorkCard.astro';
import Filters from '../../components/Filters.astro';
import TrustTiles from '../../components/TrustTiles.astro';
import Faqs from '../../components/home/Faqs.astro';
import { SITE, GOOGLE_RATING } from '../../data/site';
import { CASE_STUDIES, FILTERS, WORK_META, WORK_HERO, WORK_TRUST, WORK_FAQS } from '../../data/work';

const url = new URL(WORK_META.path, SITE).href;
const list = {
  '@type': 'ItemList',
  '@id': `${url}#case-studies`,
  name: 'Shopify case studies',
  numberOfItems: CASE_STUDIES.length,
  itemListElement: CASE_STUDIES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.client, ...(c.href && { url: new URL(c.href, SITE).href }) })),
};
// Only show a filter once it has two or more projects.
const filters = FILTERS.filter((f) => CASE_STUDIES.filter((c) => c.services.includes(f.id)).length >= 2);
const trustAfter = 6;
---
<Base title={WORK_META.title} description={WORK_META.description}>
  <Schema
    slot="head"
    type="CollectionPage"
    title={WORK_META.title}
    description={WORK_META.description}
    path={WORK_META.path}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Shopify success stories', path: WORK_META.path }]}
    mainEntity={`${url}#case-studies`}
    extra={[list]}
    faqs={WORK_FAQS.items}
  />
  <Header />
  <main id="main">
    <PageHero eyebrow={WORK_HERO.eyebrow} heading={WORK_HERO.heading} />

    <section id="case-studies" aria-label="Case studies" class="px-margin pb-section pt-section-sm">
      <Filters label="Filter by service" filters={filters} />

      <ul class="cards-align mt-section-sm grid gap-x-gutter gap-y-[64px] lg:grid-cols-2" data-grid>
        {CASE_STUDIES.map((s, i) => (
          <>
            {/* Trust row: twice the grid gap above and below, so it stands apart from the cards. */}
            {i === trustAfter && (
              <li data-filter-all class="my-[64px] lg:col-span-2">
                <TrustTiles equal items={[GOOGLE_RATING, ...WORK_TRUST.map((text) => ({ text }))]} />
              </li>
            )}
            <li data-tags={s.services.join(' ')}><WorkCard study={s} eager={i < 2} level={2} /></li>
          </>
        ))}
      </ul>
    </section>

    <div id="questions"><Faqs data={WORK_FAQS} /></div>
  </main>
</Base>

