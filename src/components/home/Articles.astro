---
// Homepage articles: the four newest in the shared articles section (two on phones).
import ArticlesSection from '../ArticlesSection.astro';
import { ARTICLES } from '../../data/home';
import { ARTICLES_LIST } from '../../data/articles';
---
<ArticlesSection
  articles={ARTICLES_LIST.slice(0, 4)}
  eyebrow={ARTICLES.eyebrow}
  heading={ARTICLES.heading}
  link={ARTICLES.link}
  class="px-margin pt-section-sm lg:pt-section-pre"
/>
