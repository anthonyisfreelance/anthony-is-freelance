---
// Mobile: solid bar. Desktop: transparent over the hero image, solid while a menu is open.
// Desktop is always a 50/50 split as in Figma: logo left, nav in the right half (it wraps when tight).
// Nav titles are links to their landing pages; hover opens the mega menu, and a small
// button after each title (shown on keyboard focus) opens it for keyboard users.
// Phones get Menu, which opens the full-screen menu in MobileMenu.astro.
// Scrolling: the header scrolls away with the page and comes back, fixed to the top, once the
// visitor has scrolled up for a fifth of a second (a nudge doesn't count). Scrolling down sends it
// away again. Over a hero photo (overlay pages, desktop) only the copy half is solid; the photo
// half stays clear wherever the photo is beneath it. Styles are in global.css.
import MegaMenu from './MegaMenu.astro';
import MobileMenu from './MobileMenu.astro';
import { MEGA, URLS } from '../data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
// Text box trimmed to cap height so the padding above and below the capitals is even (34px tall, as in Figma).
const cta = 't-button inline-flex h-[34px] shrink-0 items-center whitespace-nowrap bg-white px-[14px] text-[#111] [text-box:trim-both_cap_alphabetic] hover:opacity-90';
const triggers = [
  { id: 'mega-services', label: MEGA.services.label, href: MEGA.services.viewAll.href },
  { id: 'mega-work', label: MEGA.work.label, href: MEGA.work.viewAll.href },
  { id: 'mega-articles', label: MEGA.articles.label, href: MEGA.articles.viewAll.href },
];
---
<header
  data-header
  data-overlay={overlay ? '' : undefined}
  class:list={[
    'relative z-20 w-full bg-surface p-margin lg:py-[40px]',
    overlay && 'lg:absolute lg:left-0 lg:right-0 lg:bg-transparent lg:data-[open]:bg-surface',
  ]}
>
  <div class="flex items-center justify-between gap-gutter lg:grid lg:grid-cols-2">
    <a href={URLS.home} class="flex h-12 items-center justify-self-start lg:h-auto" aria-label="Anthony is Freelance, home">
      <img src="/icons/logo.svg" alt="Anthony is Freelance" width="172" height="44" class="h-[38px] w-auto lg:h-11" />
    </a>

    <nav aria-label="Main" class="hidden flex-wrap items-center justify-between gap-x-gutter gap-y-3 lg:flex">
      <ul class="flex flex-wrap items-center gap-x-[clamp(24px,calc(6.4286vw-68.57px),96px)] gap-y-2">
        {triggers.map((t) => (
          <li data-mega-item class="relative flex items-center after:absolute after:inset-x-0 after:top-full after:h-[var(--bridge,0px)] after:content-['']">
            <a href={t.href} data-mega-link={t.id} class="t-button-lg link-hover whitespace-nowrap text-ink data-[active]:underline">{t.label}</a>
            <button
              type="button"
              data-mega-trigger={t.id}
              aria-expanded="false"
              aria-controls={t.id}
              class="sr-only cursor-pointer focus-visible:not-sr-only focus-visible:ml-2"
            >
              <span class="sr-only">Show the {t.label} menu</span>
              <img src="/icons/plus.svg" alt="" width="14" height="14" class="size-[14px]" />
            </button>
          </li>
        ))}
      </ul>
      <a href={URLS.contact} data-project-open class={cta}>Start a project</a>
    </nav>

    <div class="flex items-center gap-gutter lg:hidden">
      <button type="button" data-menu-open aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false" class="t-button cursor-pointer text-ink">Menu</button>
    </div>
  </div>
  <MegaMenu />
</header>
<MobileMenu />

<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    if (!header) return;
    var triggers = header.querySelectorAll('[data-mega-trigger]');
    var openId = null, timer = null;
    var canHover = window.matchMedia('(hover: hover)').matches;

    function panel(id) { return document.getElementById(id); }
    function trigger(id) { return header.querySelector('[data-mega-trigger="' + id + '"]'); }

    function link(id) { return header.querySelector('[data-mega-link="' + id + '"]'); }
    var backdrop = header.querySelector('[data-mega-backdrop]');

    function close() {
      clearTimeout(timer);
      if (!openId) return;
      panel(openId).hidden = true;
      trigger(openId).setAttribute('aria-expanded', 'false');
      link(openId).removeAttribute('data-active');
      link(openId).closest('li').style.removeProperty('--bridge');
      openId = null;
      backdrop.hidden = true;
      header.removeAttribute('data-open');
    }
    function open(id) {
      clearTimeout(timer);
      if (openId === id) return;
      close();
      panel(id).hidden = false;
      trigger(id).setAttribute('aria-expanded', 'true');
      link(id).setAttribute('data-active', '');
      // An invisible bridge from the title down to the panel, so moving the pointer
      // straight down never crosses a gap that would close the menu.
      var li = link(id).closest('li');
      var gap = panel(id).getBoundingClientRect().top - li.getBoundingClientRect().bottom;
      li.style.setProperty('--bridge', Math.max(0, Math.ceil(gap)) + 'px');
      openId = id;
      backdrop.hidden = false;
      header.setAttribute('data-open', '');
    }

    // Hover: a short intent delay before opening (so passing over a title doesn't flash a menu),
    // then the menu stays open only while the pointer is on a nav title or the open panel.
    // Anywhere else (the bar, the blue backdrop, the page) closes it after a short grace period.
    var OPEN_DELAY = 150, CLOSE_DELAY = 200;
    function later(fn, ms) { clearTimeout(timer); timer = setTimeout(fn, ms); }

    // After clicking a nav title, the next page loads with the pointer already resting on that
    // title, and the first nudge of the mouse would reopen its menu. So hover stays off until the
    // pointer has been somewhere other than a nav title (or has left the one it landed on).
    var hoverReady = false;
    document.addEventListener('mousemove', function first(e) {
      document.removeEventListener('mousemove', first);
      var landed = e.target.closest && e.target.closest('[data-mega-item]');
      if (!landed) { hoverReady = true; return; }
      landed.addEventListener('mouseleave', function () { hoverReady = true; }, { once: true });
    });

    triggers.forEach(function (t) {
      var id = t.getAttribute('data-mega-trigger');
      t.addEventListener('click', function () { clearTimeout(timer); openId === id ? close() : open(id); });
      if (!canHover) return;
      var item = t.closest('li');
      item.addEventListener('mouseenter', function () {
        if (!hoverReady) return;
        later(function () { open(id); }, openId ? 0 : OPEN_DELAY);
      });
      item.addEventListener('mouseleave', function () { later(close, CLOSE_DELAY); });
      panel(id).addEventListener('mouseenter', function () { if (openId === id) clearTimeout(timer); });
      panel(id).addEventListener('mouseleave', function () { later(close, CLOSE_DELAY); });
    });

    backdrop.addEventListener('click', close);
    window.addEventListener('scroll', function () { if (openId && !header.contains(document.activeElement)) close(); }, { passive: true });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && openId) {
        var t = trigger(openId);
        close();
        t.focus();
      }
    });
    document.addEventListener('click', function (e) { if (!header.contains(e.target)) close(); });
    header.addEventListener('focusout', function (e) {
      if (e.relatedTarget && !header.contains(e.relatedTarget)) close();
    });
  })();
</script>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    if (!header) return;
    var image; // the hero photo comes after this script, so it's found on first use
    var overlay = header.hasAttribute('data-overlay');
    var desktop = window.matchMedia('(min-width: 1024px)');

    // DELAY: how long the visitor must keep scrolling up before the header returns.
    // MIN_UP: and how far, so a single small nudge never brings it back.
    var DELAY = 200, MIN_UP = 40, GAP = 300;
    var fixed = false, shown = false, spacer = null;
    var top = 0, bottom = 0, lastY = window.scrollY;
    var upStart = 0, upFrom = 0, lastUp = 0, timer = null, quietUntil = 0, ticking = false;

    function measure() {
      var r = header.getBoundingClientRect();
      top = r.top + window.scrollY;
      bottom = r.bottom + window.scrollY;
    }
    function half() {
      if (image === undefined) image = document.querySelector('[data-header-image]');
      var b = fixed && overlay && image && desktop.matches ? image.getBoundingClientRect().bottom : 0;
      if (b > 0) {
        header.setAttribute('data-half', '');
        header.style.setProperty('--img-bottom', Math.ceil(b) + 'px');
      } else header.removeAttribute('data-half');
    }
    function fix() {
      // In-flow headers leave a spacer behind so the page doesn't jump up.
      if (getComputedStyle(header).position !== 'absolute') {
        if (!spacer) { spacer = document.createElement('div'); spacer.setAttribute('aria-hidden', 'true'); header.before(spacer); }
        spacer.style.height = header.offsetHeight + 'px';
        spacer.hidden = false;
      }
      header.setAttribute('data-fixed', '');
      fixed = true;
      half();
      header.offsetHeight; // start from just above the screen, then animate down
      header.setAttribute('data-animate', '');
    }
    function unfix() {
      ['data-fixed', 'data-animate', 'data-shown', 'data-half'].forEach(function (a) { header.removeAttribute(a); });
      if (spacer) spacer.hidden = true;
      fixed = shown = false;
    }
    function show() {
      if (shown) return;
      if (!fixed) fix();
      shown = true;
      header.setAttribute('data-shown', '');
    }
    function hide() {
      if (!shown) return;
      shown = false;
      header.removeAttribute('data-shown');
    }
    function resetRun() { upStart = 0; clearTimeout(timer); timer = null; }
    function tryShow() {
      if (!upStart || Date.now() < quietUntil) return;
      if (Date.now() - upStart >= DELAY && upFrom - window.scrollY >= MIN_UP) { resetRun(); show(); }
    }

    function update() {
      ticking = false;
      var y = window.scrollY, dy = y - lastY, now = Date.now();
      lastY = y;
      if (!fixed) measure();
      // Back at the top, or hidden as the header's own place comes into view: hand back to the
      // header in its normal place (it lines up exactly, so nothing jumps).
      if (fixed && (y <= top || (!shown && y < bottom))) { unfix(); measure(); }
      if (fixed) half();
      if (dy > 0) { resetRun(); hide(); return; }
      if (dy === 0 || shown || y < bottom) { if (y < bottom) resetRun(); return; }
      if (!upStart || now - lastUp > GAP) {
        resetRun();
        upStart = now;
        upFrom = y - dy;
        timer = setTimeout(tryShow, DELAY);
      }
      lastUp = now;
      tryShow();
    }

    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', function () { if (!fixed) measure(); else half(); });

    // Jumping to a heading on the page shouldn't bring the header down over it.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#"]');
      if (a && a.pathname === location.pathname) { quietUntil = Date.now() + 1000; resetRun(); hide(); }
    });
    // Keyboard users tabbing into the hidden header bring it back.
    header.addEventListener('focusin', function () { if (fixed) show(); });

    measure();
  })();
</script>
