---
// One article as one line (Figma "Article/Index row"). Desktop: date, category, title in columns.
// Phones (and `stacked`, used in the mega menu): category and date above the title.
// The title is the only link, stretched over the row. No image, no excerpt, so nothing repeats.
import { type Article, categoryLabel, formatDate } from '../data/articles';
interface Props {
  article: Article;
  titleTag?: 'h3' | 'p'; // 'p' in menus, so they add no headings to the page
  stacked?: boolean;
}
const { article: a, titleTag: Title = 'h3', stacked = false } = Astro.props;
const wide = !stacked;
---
<article
  class:list={[
    'hover-card relative flex flex-col border-t border-line',
    // Stacked rows keep the phone sizes at any width (Figma uses the mobile row in the mega menu).
    wide ? 'gap-loose py-large lg:flex-row lg:items-center lg:gap-grid-lg' : 'gap-4 py-6',
  ]}
>
  <p class:list={['t-label flex justify-between gap-4 text-muted', wide && 'lg:contents']}>
    <span class:list={[wide && 'lg:order-2 lg:w-[180px] lg:shrink-0']}>{categoryLabel(a.category)}</span>
    <time datetime={a.date} class:list={[wide && 'lg:order-1 lg:w-[160px] lg:shrink-0']}>{formatDate(a.date)}</time>
  </p>
  <div class:list={['flex items-start gap-4', wide && 'lg:order-3 lg:flex-1 lg:items-center lg:gap-grid-lg']}>
    <Title class:list={['t-h3 flex-1 text-ink', stacked && 'lg:text-[22px]']}><a href={a.href} class="stretched-link link-hover">{a.title}</a></Title>
    <img src="/icons/arrow-up-right.svg" alt="" width="24" height="24" class:list={['size-5 shrink-0', wide && 'lg:size-6']} />
  </div>
</article>
