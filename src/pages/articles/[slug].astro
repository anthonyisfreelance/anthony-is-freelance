---
// Article template. One page per file in src/data/article-content/ (the article's blocks and FAQs,
// converted from WordPress); title, date and category come from the article list in
// src/data/articles.ts, so the cards and the page can't disagree.
// Desktop: contents down the left, the article in a reading column. Phones: contents fold away.
// Images drop in by file name (src/assets/articles/<slug>/), placeholders until then.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import TextLink from '../../components/TextLink.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Faqs from '../../components/home/Faqs.astro';
import Contact from '../../components/home/Contact.astro';
import { SITE, ENTITY, URLS } from '../../data/site';
import { ARTICLES_LIST, ARTICLES_PAGE, categoryLabel, type Article } from '../../data/articles';
import { articleImage } from '../../data/media';
import photo from '../../assets/site/anthony.jpg';

interface Block { type: 'h2' | 'h3' | 'html' | 'image'; text?: string; id?: string; html?: string; file?: string; alt?: string }
interface Content {
  seoTitle: string;
  description: string;
  published: string;
  modified: string;
  hero: { file: string; alt: string };
  faqHeading: string;
  blocks: Block[];
  faqs: { q: string; html: string }[];
}

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Content }>('../../data/article-content/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.json', '');
    const article = ARTICLES_LIST.find((a) => a.href === `/articles/${slug}/`)!;
    return { params: { slug }, props: { slug, article, content: mod.default } };
  });
}

const { slug, article, content: c } = Astro.props as { slug: string; article: Article; content: Content };
const url = new URL(article.href, SITE).href;
const toc = c.blocks.filter((b) => b.type === 'h2');
const words = c.blocks.reduce((n, b) => n + (b.html ?? b.text ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length, 0);
const minutes = Math.max(1, Math.round(words / 220));
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const hero = articleImage(slug, c.hero.file);
const faqs = c.faqs.map((f) => ({ q: f.q, html: f.html, a: [f.html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim()] }));
const related = [
  ...ARTICLES_LIST.filter((a) => a.href !== article.href && a.category === article.category),
  ...ARTICLES_LIST.filter((a) => a.href !== article.href && a.category !== article.category),
].slice(0, 3);

const posting = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: article.title,
  description: c.description,
  datePublished: c.published,
  dateModified: c.modified,
  author: { '@id': ENTITY.person.id },
  publisher: { '@id': ENTITY.business.id },
  mainEntityOfPage: { '@id': `${url}#webpage` },
  articleSection: categoryLabel(article.category),
  wordCount: words,
  inLanguage: 'en-GB',
};
const a = ARTICLES_PAGE.author;
---
<Base title={`${c.seoTitle} | Anthony is Freelance`} description={c.description}>
  <Schema
    slot="head"
    title={c.seoTitle}
    description={c.description}
    path={article.href}
    about={ENTITY.person.id}
    mainEntity={`${url}#article`}
    breadcrumbs={[{ name: 'Home', path: URLS.home }, { name: 'Articles', path: URLS.articles }, { name: article.title, path: article.href }]}
    extra={[posting]}
    faqs={faqs}
  />
  <!-- TEMPORARY: colour comparison. ?look=soft (off-white body) or ?look=light (light article).
       Remove once the article colour is decided. -->
  <script is:inline slot="head">
    (() => { const l = new URLSearchParams(location.search).get('look'); if (l) document.documentElement.dataset.look = l; })();
  </script>
  <Header />
  <main id="main">
    <article>
      <!-- Head: category, title, byline. Text only, so the title runs to 70% like other text headers. -->
      <header class="px-margin">
        <div class="flex flex-col gap-large border-t border-line pt-large lg:pt-[40px]">
          <Heading level={1} eyebrow={categoryLabel(article.category)} class="lg:w-[70%]">{article.title}</Heading>
          <div class="flex items-center gap-3">
            <Image src={photo} alt="" widths={[48, 96]} sizes="48px" class="size-12 shrink-0 rounded-full object-cover" />
            <p class="t-label flex flex-wrap gap-x-3 gap-y-1 tracking-[0.02em] text-muted">
              <span>By <a href={URLS.about} rel="author" class="text-ink underline underline-offset-4 hover:decoration-2">Anthony Bliss</a></span>
              <span aria-hidden="true">·</span>
              <span>Published <time datetime={c.published}>{fmt(c.published)}</time></span>
              {c.modified !== c.published && <><span aria-hidden="true">·</span><span>Updated <time datetime={c.modified}>{fmt(c.modified)}</time></span></>}
              <span aria-hidden="true">·</span>
              <span>{minutes} min read</span>
            </p>
          </div>
        </div>
      </header>

      <figure class="mt-large px-margin">
        {hero ? (
          <Image src={hero} alt={c.hero.alt} widths={[480, 750, 1200, 1800, 2400]} sizes="(min-width: 2560px) 2512px, 100vw" loading="eager" class="aspect-[2/1] w-full object-cover" />
        ) : (
          <div class="flex aspect-[2/1] w-full items-center justify-center bg-raised p-6"><p class="t-badge max-w-[40ch] text-center text-muted">Image to come: {c.hero.alt}</p></div>
        )}
      </figure>

      <!-- Body: contents on the left (desktop), the article in a reading column -->
      <div class="px-margin pt-section lg:grid lg:grid-cols-12 lg:gap-x-gutter">
        <nav aria-label="Contents" class="mb-large lg:col-span-3 lg:mb-0">
          <details class="group border-y border-line lg:sticky lg:top-loose lg:border-0" open>
            <summary class="t-badge flex cursor-pointer items-center justify-between py-3 text-ink lg:pointer-events-none lg:py-0 lg:pb-loose">
              Contents
              <img src="/icons/plus.svg" alt="" width="18" height="18" class="size-[18px] group-open:rotate-45 lg:hidden" />
            </summary>
            <ol class="flex flex-col pb-loose lg:pb-0" data-toc>
              {toc.map((h) => <li><a href={`#${h.id}`} class="t-label toc-link py-1.5">{h.text}</a></li>)}
              {faqs.length > 0 && <li><a href="#questions" class="t-label toc-link py-1.5">Frequently asked questions</a></li>}
            </ol>
          </details>
        </nav>

        <div class="prose-article lg:col-span-6 lg:col-start-5">
          {c.blocks.map((b) =>
            b.type === 'h2' ? <h2 id={b.id}>{b.text}</h2>
            : b.type === 'h3' ? <h3>{b.text}</h3>
            : b.type === 'image' ? (() => {
                const img = articleImage(slug, b.file!);
                return (
                  <figure>
                    {img
                      ? <Image src={img} alt={b.alt!} widths={[480, 750, 1100, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="h-auto w-full" />
                      : <div class="flex aspect-[3/2] w-full items-center justify-center bg-raised p-6"><p class="t-badge max-w-[40ch] text-center text-muted">Image to come: {b.alt}</p></div>}
                  </figure>
                );
              })()
            : <Fragment set:html={b.html} />
          )}
        </div>
      </div>

      {faqs.length > 0 && (
        <div id="questions" class="scroll-mt-8">
          <Faqs data={{ eyebrow: 'Frequently asked questions', heading: c.faqHeading, items: faqs }} />
        </div>
      )}
    </article>

    <!-- About the author -->
    <section class="px-margin pt-section-sm">
      <div class="grid gap-gutter border-t border-line pt-section lg:grid-cols-2">
        <Heading eyebrow="About the author">Anthony Bliss.</Heading>
        <div class="flex flex-col gap-loose sm:flex-row sm:items-start sm:gap-grid">
          <div class="relative aspect-[4/5] w-[140px] shrink-0 overflow-hidden lg:w-[180px]">
            <Image src={photo} alt="Anthony Bliss" widths={[180, 360]} sizes="180px" class="absolute inset-0 size-full object-cover" />
          </div>
          <div class="t-body flex flex-col gap-loose text-muted">
            <p class="t-h7 text-ink">{a.award}</p>
            <p>{a.experience.replace(/ Every article here is held to the same rules:$/, '')}</p>
            <div class="flex flex-wrap gap-x-grid gap-y-4">
              <TextLink href={URLS.about}>More about how I work</TextLink>
              <TextLink href={`${URLS.articles}#standards`}>How articles are written</TextLink>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- More articles -->
    <section class="px-margin pb-section pt-section">
      <div class="border-t border-line pt-section">
        <div class="lg:flex lg:items-end lg:justify-between lg:gap-gutter">
          <Heading eyebrow="Shopify design articles" class="lg:w-half">Keep reading.</Heading>
          <div class="mt-loose lg:mt-0"><TextLink href={URLS.articles}>View all articles</TextLink></div>
        </div>
        <ul class="mt-large grid grid-cols-2 gap-x-grid gap-y-large lg:grid-cols-3">
          {related.map((r, i) => <li class:list={[i > 1 && 'max-lg:hidden']}><ArticleCard article={r} titleTag="h3" /></li>)}
        </ul>
      </div>
    </section>

    <Contact />
  </main>
  <script is:inline>
    // Contents: mark the section being read (the last heading above the top fifth of the screen).
    (() => {
      const links = [...document.querySelectorAll('[data-toc] a')];
      const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter(Boolean);
      if (!targets.length) return;
      let ticking = false;
      const update = () => {
        ticking = false;
        const line = window.innerHeight * 0.2;
        let i = -1;
        targets.forEach((t, n) => { if (t.getBoundingClientRect().top <= line) i = n; });
        links.forEach((a, n) => (n === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('hashchange', update);
      update();
    })();
  </script>
</Base>
