---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ProjectDialog from '../components/ProjectDialog.astro';

interface Props {
  title: string;
  description: string;
  announcement?: boolean;
  /** Big screens: from 1920px the headings grow with the screen, and past 2560px the page stops
      growing and centres (see .page-scale in global.css). On by default. */
  scale?: boolean;
}
const { title, description, announcement = true, scale = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GB" class:list={['theme-dark', scale && 'page-scale']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," /><!-- [CONFIRM] favicon file to come -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <link rel="preload" href="/fonts/mint-grotesk-display-narrow-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-pro-400.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-[#111]">Skip to content</a>
    {announcement && <AnnouncementBar />}
    <div class="page-frame">
      <slot />
      <Footer />
    </div>
    <StickyCta />
    <ProjectDialog />
  </body>
</html>
