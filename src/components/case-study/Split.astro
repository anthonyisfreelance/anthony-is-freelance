---
// A 50/50 block between work rows: a lifestyle photo to one screen edge, and screens on a flat tint
// picked from the photo on the other. No text on the photo.
//
// Two forms:
//  - `screens` (Figma "Property 1=50/50", 48323:17501, 27 October 2026): a square photo that sticks
//    while a phone, a desktop and a phone scroll past it. At 1440: two 720 columns, the panel 80 above
//    and below, 64 each side, 120 between screens, phones 317 wide, the desktop 592 by 333.
//  - `screen`: one phone beside a 700:875 photo, the screen 309 wide, 64 above and 80 below.
import Media from './Media.astro';
import type { Split } from '../../data/case-studies/types';
interface Props { split: Split; class?: string }
const { split, class: className = '' } = Astro.props;
const left = (split.photoSide ?? 'left') === 'left';
const screens = split.screens ?? [];
---
{screens.length ? (
  <section class:list={['flex flex-col lg:flex-row lg:items-start', className]} aria-label={split.label}>
    <figure class:list={['lg:sticky lg:top-0 lg:w-1/2 lg:shrink-0', !left && 'lg:order-2']}>
      <Media media={split.photo} fit="cover" sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-square w-full lg:aspect-auto lg:h-[min(50vw,100dvh)]" />
    </figure>
    <div
      class:list={['flex flex-1 flex-col items-center gap-large px-margin py-section lg:gap-[120px] lg:px-[64px] lg:py-[80px]', !left && 'lg:order-1']}
      style={`background-color: ${split.tint}`}
    >
      {screens.map((s) => s.device === 'desktop' ? (
        <Media media={s.media} fit="cover" sizes="(min-width: 1024px) 592px, 100vw" class="aspect-[592/333] w-full lg:w-[min(calc(50vw-128px),592px)]" />
      ) : (
        <Media media={s.media} sizes="(min-width: 1024px) 317px, 60vw" class="aspect-[375/820] w-[60%] lg:w-[min(calc((50vw-128px)*0.5355),317px)]" />
      ))}
    </div>
  </section>
) : (
  <section class:list={['flex flex-col lg:flex-row', className]} aria-label={split.label}>
    <figure class:list={['lg:w-[48.61%] lg:shrink-0', !left && 'lg:order-2']}>
      <Media media={split.photo} fit="cover" sizes="(min-width: 1024px) 49vw, 100vw" class="aspect-[700/875] w-full" />
    </figure>
    <div
      class:list={['flex flex-1 items-center justify-center px-gutter pb-[80px] pt-section lg:pt-[64px]', !left && 'lg:order-1']}
      style={`background-color: ${split.tint}`}
    >
      {split.screen && <Media media={split.screen} sizes="(min-width: 1024px) 309px, 60vw" class="aspect-[375/820] w-[60%] max-w-[309px] lg:w-[min(calc((51.39vw-64px)*0.4573),309px)]" />}
    </div>
  </section>
)}
