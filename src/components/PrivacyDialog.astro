---
// Privacy notice in a panel over the page (feedback #264, 29 October 2026), so a link to it from the
// enquiry form or the cookie banner doesn't take anyone away from what they were doing. Links that
// carry data-privacy-open open it; they are still real links to /privacy-policy/, so they work before
// the script runs and with modifier keys. The notice itself is fetched from the privacy page the first
// time the panel opens, so it isn't repeated in every page's HTML and there's only one copy to keep.
// A modal <dialog>: focus stays inside, Escape closes it and the page behind is inert.
import { URLS } from '../data/site';
---
<dialog
  id="privacy-dialog"
  data-privacy-dialog
  aria-labelledby="privacy-dialog-title"
  class="m-0 ml-auto h-dvh max-h-none w-full max-w-[720px] overflow-hidden border-0 bg-surface p-0 text-ink backdrop:bg-blue/60"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-grid border-b border-line px-margin py-loose lg:px-[48px]">
      <h2 id="privacy-dialog-title" class="t-h7 text-ink">Privacy and cookies</h2>
      <button type="button" data-privacy-close aria-label="Close" class="t-button flex cursor-pointer items-center text-ink">
        <img src="/icons/close.svg" alt="" width="18" height="18" class="size-[18px]" />
      </button>
    </div>
    <div data-privacy-body class="flex-1 overflow-y-auto px-margin pb-section pt-large lg:px-[48px]">
      <p class="t-body text-muted" data-privacy-loading>Loading…</p>
    </div>
    <div class="border-t border-line px-margin py-loose lg:px-[48px]">
      <a href={URLS.privacy} class="t-label text-muted underline underline-offset-4 hover:decoration-2">Open the full page</a>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dialog = document.querySelector('[data-privacy-dialog]');
    if (!dialog) return;
    var body = dialog.querySelector('[data-privacy-body]');
    var loaded = null;
    function load(href) {
      if (!loaded) {
        loaded = fetch(href.split('#')[0], { credentials: 'same-origin' })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var prose = doc.querySelector('main .prose-article');
            if (!prose) throw new Error('no notice');
            var updated = doc.querySelector('main time');
            body.innerHTML = '';
            if (updated) {
              var p = document.createElement('p');
              p.className = 't-label mb-large tracking-[0.02em] text-muted';
              p.textContent = 'Updated ' + updated.textContent;
              body.appendChild(p);
            }
            var copy = document.importNode(prose, true);
            copy.className = 'prose-article prose-dialog';  // the page's column width doesn't apply in the panel
            body.appendChild(copy);
          })
          .catch(function () { loaded = null; throw new Error('failed'); });
      }
      return loaded;
    }
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[data-privacy-open]');
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      var href = link.getAttribute('href');
      var hash = href.indexOf('#') > -1 ? href.slice(href.indexOf('#') + 1) : '';
      if (!dialog.open) dialog.showModal();
      body.scrollTop = 0;
      load(href).then(function () {
        var target = hash && body.querySelector('#' + CSS.escape(hash));
        body.scrollTop = target ? target.offsetTop - body.offsetTop - 24 : 0;
      }, function () { location.href = href; });
    });
    dialog.querySelector('[data-privacy-close]').addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
  })();
</script>
