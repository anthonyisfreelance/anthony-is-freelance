---
// Innovations: the home of every innovation, in full. Built from the innovation records in
// src/data/innovations.ts, grouped by the shopping journey. Copy and structure from
// page-copy/innovations.md. Groups without an innovation yet are left out.
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Heading from '../../components/Heading.astro';
import TextLink from '../../components/TextLink.astro';
import ScreenTile from '../../components/ScreenTile.astro';
import Faqs from '../../components/home/Faqs.astro';
import Contact from '../../components/home/Contact.astro';
import { SITE, ENTITY, URLS } from '../../data/site';
import { INNOVATIONS_LIST, INNOVATION_GROUPS, INNOVATIONS_PAGE as P } from '../../data/innovations';

const url = new URL(P.path, SITE).href;
const groups = INNOVATION_GROUPS.map((g) => ({ ...g, items: INNOVATIONS_LIST.filter((i) => i.group === g.id) })).filter((g) => g.items.length);

// Schema: the page's ItemList, one CreativeWork per innovation, with its video.
const items = await Promise.all(
  INNOVATIONS_LIST.map(async (it, n) => {
    const poster = new URL((await getImage({ src: it.poster, width: 750 })).src, SITE).href;
    return {
      '@type': 'ListItem',
      position: n + 1,
      item: {
        '@type': 'CreativeWork',
        '@id': `${url}#${it.slug}`,
        url: `${url}#${it.slug}`,
        name: it.name,
        description: it.howItWorks,
        creator: { '@id': ENTITY.person.id },
        dateCreated: it.year,
        about: { '@type': 'Organization', name: it.client },
        ...(it.clientHref && { isPartOf: { '@type': 'WebPage', url: new URL(it.clientHref, SITE).href } }),
        ...(it.video && {
          video: {
            '@type': 'VideoObject',
            name: it.name,
            description: it.caption,
            thumbnailUrl: poster,
            contentUrl: new URL(it.video, SITE).href,
            uploadDate: it.videoUploaded,
          },
        }),
      },
    };
  }),
);
const list = { '@type': 'ItemList', '@id': `${url}#innovations`, name: 'Shopify UX examples', numberOfItems: items.length, itemListElement: items };
const label = 't-label tracking-[0.02em] text-muted';
---
<Base title={P.title} description={P.description}>
  <Schema
    slot="head"
    type="CollectionPage"
    title={P.title}
    description={P.description}
    path={P.path}
    breadcrumbs={[{ name: 'Home', path: URLS.home }, { name: 'Shopify success stories', path: URLS.work }, { name: 'Innovations', path: P.path }]}
    mainEntity={`${url}#innovations`}
    extra={[list]}
    faqs={P.faqs.items}
  />
  <Header />
  <main id="main">
    <PageHero eyebrow={P.eyebrow} heading={P.heading} intro={P.intro} />

    {groups.map((g) => (
      <section id={g.id} class="px-margin pt-section">
        <div class="border-t border-line pt-section">
          <SectionIntro eyebrow={g.eyebrow} heading={g.heading}>
            {'intro' in g && g.intro && <p slot="intro">{g.intro}</p>}
          </SectionIntro>
          <div class="mt-gutter flex flex-col gap-section">
            {g.items.map((it) => (
              <article id={it.slug} class="grid scroll-mt-6 gap-large border-t border-line pt-large lg:grid-cols-2 lg:gap-gutter">
                <div class="flex flex-col gap-loose lg:pr-gutter">
                  <h3 class="t-h5 text-ink">{it.name}</h3>
                  <p class={label}>
                    {it.clientHref ? <a href={it.clientHref} class="text-ink underline underline-offset-4 hover:decoration-2">{it.client}</a> : it.client} · {it.year}
                  </p>
                  <dl class="flex flex-col gap-loose">
                    <div class="flex flex-col gap-2"><dt class={label}>The problem</dt><dd class="t-body text-muted">{it.problem}</dd></div>
                    <div class="flex flex-col gap-2"><dt class={label}>How it works</dt><dd class="t-body text-muted">{it.howItWorks}</dd></div>
                    {it.evidence && <div class="flex flex-col gap-2"><dt class={label}>Evidence</dt><dd class="t-body text-muted">{it.evidence}</dd></div>}
                  </dl>
                  <p class={label}>Part of <a href={it.service.href} class="text-ink underline underline-offset-4 hover:decoration-2">{it.service.label}</a></p>
                </div>
                <figure class="flex flex-col gap-3 max-lg:order-first">
                  <ScreenTile screen={it.poster} video={it.video} controls alt={it.alt} label={it.caption} sizes="(min-width: 1024px) 24vw, 50vw" />
                  <figcaption class={label}>{it.caption}</figcaption>
                </figure>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- The test -->
    <section id="the-test" class="px-margin pt-section">
      <div class="grid gap-gutter border-t border-line pt-section lg:grid-cols-2">
        <Heading eyebrow={P.test.eyebrow}>{P.test.heading}</Heading>
        <div class="t-body flex flex-col gap-loose text-muted">
          {P.test.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <div id="questions"><Faqs data={P.faqs} /></div>

    <Contact eyebrow={P.cta.eyebrow} heading={P.cta.heading} intro={P.cta.intro} />
  </main>
</Base>
