---
// The still paints first (it's the LCP image). The reel loads after the page has
// finished, fades in over the still, and is skipped for reduced motion or Save-Data.
import { Image } from 'astro:assets';
import poster from '../assets/site/showreel-poster.jpg';
import { versioned } from '../data/media';
const src = (size: string, av1: boolean) => versioned(`/video/showreel-${size}${av1 ? '-av1' : ''}.mp4`);
---
<Image
  src={poster}
  alt=""
  widths={[375, 560, 750, 1000, 1440]}
  quality={75}
  sizes="(min-width: 1024px) 49vw, 100vw"
  loading="eager"
  fetchpriority="high"
  class="absolute inset-0 size-full object-cover"
/>
<video
  data-showreel
  data-desktop={src('desktop', false)}
  data-desktop-av1={src('desktop', true)}
  data-mobile={src('mobile', false)}
  data-mobile-av1={src('mobile', true)}
  class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500"
  muted
  loop
  playsinline
  preload="none"
  aria-hidden="true"
  tabindex="-1"
></video>
<!-- Figma: linear gradient, black to clear, 80% opacity, so the logo reads over the reel. Desktop only. -->
<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(to_bottom,rgba(0,0,0,0.35)_0%,rgba(0,0,0,0)_21%)] lg:block"
></div>
<button
  type="button"
  data-showreel-toggle
  hidden
  class="t-button absolute bottom-3 right-3 z-10 bg-[#111]/70 px-2 py-1 text-white hover:bg-[#111]"
>Pause</button>
<script is:inline>
  (function () {
    var v = document.querySelector('[data-showreel]');
    var btn = document.querySelector('[data-showreel-toggle]');
    if (!v) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var c = navigator.connection;
    if (c && (c.saveData || /2g/.test(c.effectiveType || ''))) return;

    function start() {
      var size = window.matchMedia('(min-width: 1024px)').matches ? 'desktop' : 'mobile';
      var av1 = v.canPlayType('video/mp4; codecs="av01.0.05M.08"');
      v.src = v.getAttribute('data-' + size + (av1 ? '-av1' : ''));
      v.addEventListener('playing', function () {
        v.style.opacity = '1';
        btn.hidden = false;
      }, { once: true });
      v.play().catch(function () {});
    }

    // Keep the button 12px above the bottom of the screen while the reel runs past it (the reel is a
    // full-height panel pushed down by the announcement bar until it sticks).
    // Desktop only: on phones the reel is a square in the page flow, so the button stays in its corner.
    var frame = btn.parentElement, ticking = false, desk = window.matchMedia('(min-width: 1024px)');
    function place() {
      ticking = false;
      var r = frame.getBoundingClientRect();
      var hidden = desk.matches ? Math.min(Math.max(0, r.bottom - window.innerHeight), r.height - 60) : 0;
      btn.style.bottom = (12 + Math.max(0, hidden)) + 'px';
    }
    function queue() { if (!ticking) { ticking = true; requestAnimationFrame(place); } }
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    queue();

    btn.addEventListener('click', function () {
      if (v.paused) { v.play(); btn.textContent = 'Pause'; }
      else { v.pause(); btn.textContent = 'Play'; }
    });

    if (document.readyState === 'complete') setTimeout(start, 200);
    else window.addEventListener('load', function () { setTimeout(start, 200); });
  })();
</script>
