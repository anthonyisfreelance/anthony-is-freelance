---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  announcement?: boolean;
  /** Preview image path (og:image), e.g. an article's /og/<slug>.png. 1200 x 675. */
  image?: string;
  ogType?: 'website' | 'article';
}
const { title, description, announcement = true, image, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en-GB" class="theme-dark">
  <head>
    <script is:inline>
      // TEMPORARY: article image trial. ?hero=tile shows the new tiles, ?hero=live the live site's images.
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('hero');
          if (q) sessionStorage.setItem('aif-hero', q);
          if ((q || sessionStorage.getItem('aif-hero')) === 'tile') document.documentElement.dataset.hero = 'tile';
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," /><!-- [CONFIRM] favicon file to come -->
    <!-- Lets Google show large image previews (Discover and mobile results). -->
    <meta name="robots" content="max-image-preview:large" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="675" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="preload" href="/fonts/mint-grotesk-display-narrow-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-pro-400.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-[#111]">Skip to content</a>
    {announcement && <AnnouncementBar />}
    <slot />
    <Footer />
    <StickyCta />
    <ProjectDialog />
    <ConsentBanner />
    <script is:inline>
      // Test-site comment tool (public/feedback.js). Loads only after ?feedback has been
      // visited in this browser, never on anthonyis.uk. ?feedback=off switches it off.
      (function () {
        try {
          if (/(^|\.)anthonyis\.uk$/.test(location.hostname)) return;
          var q = new URLSearchParams(location.search).get('feedback');
          if (q === 'off') { localStorage.removeItem('aif-fb'); return; }
          if (q === null && localStorage.getItem('aif-fb') !== '1') return;
          var s = document.createElement('script');
          s.src = '/feedback.js';
          document.head.appendChild(s);
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Screen recordings (video[data-autoplay]) play while on screen and pause off it. Nothing
      // downloads until a video is first in view. Reduced motion and Save-Data keep the still;
      // videos with controls can still be played by hand. data-fade videos fade in over their still.
      (function () {
        var vids = document.querySelectorAll('video[data-autoplay]');
        if (!vids.length || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator.connection && navigator.connection.saveData)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var v = e.target;
            if (e.isIntersecting) v.play().catch(function () {});
            else v.pause();
          });
        }, { rootMargin: '200px' });
        vids.forEach(function (v) {
          if (v.hasAttribute('data-fade')) v.addEventListener('playing', function () { v.style.opacity = 1; }, { once: true });
          io.observe(v);
        });
      })();
    </script>
  </body>
</html>
