{
  // Static site served from Cloudflare Workers static assets.
  // The worker only runs for /api/* (the form and the test-site comment tool) and the 410s; every other
  // request goes straight to the files in ./dist. The cron below runs the insights queue.
  "name": "anthony-is-freelance",
  "compatibility_date": "2026-10-18",
  "main": "./worker/index.js",
  // nodejs_compat and the browser binding are for the client documents' PDFs (worker/docs/pdf.js).
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  // The insights database (worker/insights/db.js). The worker creates its own tables on first use.
  "d1_databases": [
    { "binding": "INSIGHTS_DB", "database_name": "insights", "database_id": "820dbc54-39e8-46e8-802e-d2032d9fdaf1" }
  ],
  // Every 5 minutes: the insights run queue and each brand's weekly run (worker/insights/runner.js).
  // With nothing queued it stops after one query.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Per-IP rate limits for docs.anthonyis.uk (worker/docs/security.js) and the contact form. Period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "DOCS_RL_READ", "namespace_id": "26111301", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOCS_RL_POST", "namespace_id": "26111302", "simple": { "limit": 20, "period": 60 } },
    { "name": "DOCS_RL_CODE", "namespace_id": "26111304", "simple": { "limit": 5, "period": 60 } },
    { "name": "DOCS_RL_PDF", "namespace_id": "26111303", "simple": { "limit": 10, "period": 60 } },
    // The contact form (worker/enquiry.js): each send also emails the person who filled it in.
    { "name": "ENQUIRY_RL", "namespace_id": "26111305", "simple": { "limit": 3, "period": 60 } }
  ],
  // Plain settings for the enquiry form (worker/enquiry.js). Kept here so a deploy never wipes them.
  // The Resend key is a secret, set in the dashboard, and secrets survive deploys.
  "vars": {
    "ENQUIRY_FROM": "Anthony Bliss <hello@mail.anthonyis.uk>",
    // Sender for document codes and notices (worker/docs/mail.js).
    "DOCS_FROM": "Anthony is Freelance <documents@mail.anthonyis.uk>",
    // The client documents' own subdomain (a custom domain on this worker).
    "DOCS_HOST": "docs.anthonyis.uk",
    // The insights subdomain (a custom domain on this worker), and its engine settings
    // (worker/insights/README.md, Settings). Model names checked against OpenAI's docs on 27 Nov 2026.
    "INSIGHTS_HOST": "insights.anthonyis.uk",
    "INSIGHTS_ENGINE_MODEL": "chat-latest",
    "INSIGHTS_SCORER_MODEL": "gpt-6-luna",
    "INSIGHTS_BATCH": "4"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      // Client quotes, contracts and invoices on docs.anthonyis.uk (worker/docs/). "/" sends the
      // subdomain's root to anthonyis.uk; on anthonyis.uk itself these paths fall through to the site.
      "/",
      "/quote/*",
      "/invoice/*",
      // Insights reports on insights.anthonyis.uk (worker/insights/; phase 2). "/" and "/admin/*" serve it too.
      "/report/*",
      "/admin",
      "/admin/*",
      // Old WordPress images, 301 to their new copies (oldImage in worker/index.js)
      "/wp-content/uploads/*",
      // Removed pages that answer 410 (GONE in worker/index.js)
      "/portfolio/the-brand-manual*",
      "/portfolio/proconvey-video*",
      "/portfolio/inlight-beauty-shopify-case-study*",
      "/portfolio/stovefitters-shopify-case-study*",
      "/portfolio/trebah-garden*",
      "/portfolio/the-chocolate-gift-co-shopify-case-study*",
      "/portfolio/lou-coulson-associates*",
      "/portfolio/willow-stone*",
      "/portfolio/the-box*",
      "/portfolio/cloudberry*",
      // Attachment pages (map row 74): case study images one level down, demo media, and the stragglers
      "/portfolio/*/*",
      "/demo-media-*",
      "/anthony-bliss-freela2x-light*",
      "/2cfe64aa-db05-4ce3-bbfd-9f5c7243b084-2*",
      "/drink-finder-hero-2-2*",
      "/back-in-stock*",
      "/recipes-m*",
      "/red-bull*",
      "/shopify-website-design/east-west-apparel-hero_white*",
      "/1-1-christopherdaviddesign_edit-2-without-begining-frame_1080p*"
    ]
  }
}
