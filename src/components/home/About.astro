---
// Mobile: heading, square image, then text. Desktop: image left, heading and text bottom right.
import { Image } from 'astro:assets';
import Heading from '../Heading.astro';
import TextLink from '../TextLink.astro';
import { ABOUT } from '../../data/home';
import image from '../../assets/site/anthony-about.jpg';
---
<section class="px-margin pt-section lg:pt-section-sm">
  <div class="grid gap-loose lg:grid-cols-2 lg:grid-rows-[1fr_auto_auto] lg:gap-x-gutter">
    <Heading eyebrow={ABOUT.eyebrow} deco={false} class="lg:col-start-2 lg:row-start-2 lg:pb-loose">{ABOUT.heading}</Heading>
    <div class="relative aspect-square lg:aspect-[4/5] lg:col-start-1 lg:row-span-3 lg:row-start-1">
      <Image src={image} alt={ABOUT.imageAlt} widths={[400, 750, 1000, 1400]} sizes="(min-width: 1024px) 48vw, 100vw" class="absolute inset-0 size-full object-cover" />
    </div>
    <div class="flex flex-col gap-loose lg:col-start-2 lg:row-start-3">
      <div class="t-body flex flex-col gap-[10px] text-muted">
        <p>{ABOUT.lead.before}<a href={ABOUT.lead.link.href} class="text-ink underline underline-offset-4 hover:decoration-2">{ABOUT.lead.link.label}</a>{ABOUT.lead.after}</p>
        {ABOUT.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div><TextLink href={ABOUT.link.href}>{ABOUT.link.label}</TextLink></div>
    </div>
  </div>
</section>
