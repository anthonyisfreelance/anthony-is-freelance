---
// Visible breadcrumb (Figma "Article/Breadcrumb"). Matches the BreadcrumbList in the page schema.
// The last item is the current page: plain text, not a link.
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <!-- One line that scrolls sideways when it runs out of room (feedback #210) -->
  <ol class="t-label flex gap-x-2 overflow-x-auto whitespace-nowrap text-muted [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {items.map((it, i) => (
      <li class="flex shrink-0 gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{it.name}</span>
          : <a href={it.path} class="link-hover">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
