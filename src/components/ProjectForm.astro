---
// The start-a-project form (Figma "Contact Form"). Used in place at the foot of pages
// (home/Contact.astro) and in the overlay that every Start a project button opens (ProjectDialog.astro).
// Phones: 12px labels, 34px fields, two-column budget, full-width Send with an arrow.
// From 1024px: 14px labels, 42px fields, three columns, Send message.
import { CONTACT } from '../data/home';
const field = 't-tile h-[34px] w-full border border-line bg-surface px-3 text-ink placeholder:text-muted lg:h-[42px]';
const label = 't-tile text-ink';
---
<!-- Posts to /api/enquiry (worker/enquiry.js), which emails it to Anthony. The script below sends it in
     place and shows the result; without JavaScript the post still works and lands on /contact/thanks/. -->
<form method="post" action="/api/enquiry" data-enquiry class="flex flex-col gap-6">
  <!-- Spam traps: a field people never see, and when the form was opened (set by the script). -->
  <div class="sr-only" aria-hidden="true">
    <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="t" value="" />
  <input type="hidden" name="page" value="" />
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <label class="flex flex-col gap-2"><span class={label}>Name</span><input class={field} type="text" name="name" autocomplete="name" required /></label>
    <label class="flex flex-col gap-2"><span class={label}>Email</span><input class={field} type="email" name="email" autocomplete="email" required /></label>
    <label class="col-span-2 flex flex-col gap-2 lg:col-span-1"><span class={label}>Your website</span><input class={field} type="text" name="website" placeholder="Yourstore.com" inputmode="url" autocomplete="url" /></label>
  </div>
  <fieldset class="flex flex-col gap-2">
    <legend class={`${label} mb-2`}>Budget</legend>
    <div class="grid grid-cols-2 gap-2 lg:grid-cols-3 lg:gap-x-4">
      {CONTACT.budgets.map((b) => (
        <label class="t-tile flex cursor-pointer items-center gap-2 border border-line px-3 py-2 text-muted has-[:checked]:border-ink has-[:checked]:text-ink has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-blue lg:py-3">
          <input type="radio" name="budget" value={b} class="size-[14px] shrink-0 appearance-none rounded-full border border-ink checked:bg-[radial-gradient(circle,var(--c-text)_45%,transparent_50%)] focus-visible:outline-none" />
          {b}
        </label>
      ))}
    </div>
  </fieldset>
  <label class="flex flex-col gap-2">
    <span class={label}>Message (optional)</span>
    <textarea name="message" placeholder="Type your message..." class={`${field} h-[99px] resize-y py-3 lg:h-[174px]`}></textarea>
  </label>
  <label class="flex flex-col gap-2 lg:w-[calc((100%-32px)/3)]">
    <span class={label}>{CONTACT.found.label}</span>
    <span class="relative">
      <select name="found" class={`${field} cursor-pointer appearance-none pr-10`}>
        <option value="">Choose one</option>
        {CONTACT.found.options.map((o) => <option value={o}>{o}</option>)}
      </select>
      <svg viewBox="0 0 18 18" width="18" height="18" fill="none" aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 size-[18px] -translate-y-1/2 text-ink"><path d="M5.4 7.2L9 10.8L12.6 7.2" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" /></svg>
    </span>
  </label>
  <p data-enquiry-status role="status" aria-live="polite" class="t-body text-ink empty:hidden"></p>
  <div>
    <button type="submit" class="t-button-lg flex w-full cursor-pointer items-center justify-between gap-2 bg-ink px-4 py-[15px] text-surface hover:opacity-90 lg:w-auto">
      <span class="lg:hidden">Send</span><span class="hidden lg:inline">Send message</span>
      <img src="/icons/arrow-right.svg" alt="" width="18" height="18" class="size-[18px] lg:hidden" />
    </button>
  </div>
</form>

<script>
  // Sends the enquiry without leaving the page, then swaps the form for a thank-you line.
  // Shared by every copy of the form on the page (the page's own and the Start a project overlay).
  const ERROR = 'Sorry, that didn’t send. Please try again, or email hello@anthonyis.uk.';
  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-enquiry-status]')!;
    const set = (name: string, value: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el) el.value = value;
    };
    set('t', String(Date.now()));
    set('page', location.pathname);
    if (new URLSearchParams(location.search).get('enquiry') === 'error') status.textContent = ERROR;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || ERROR);
        const name = String(new FormData(form).get('name') || '').split(' ')[0];
        form.replaceChildren(Object.assign(document.createElement('p'), {
          className: 't-h5 text-ink',
          textContent: `Thanks${name ? `, ${name}` : ''}. Your message is with me, and I’ll reply within two working days.`,
        }));
        // GA4 key event through Zaraz, which only sends it once cookies are accepted.
        (window as any).zaraz?.track?.('generate_lead', { form_location: location.pathname });
      } catch (err) {
        status.textContent = err instanceof Error && err.message ? err.message : ERROR;
        button.disabled = false;
      }
    });
  });
</script>
