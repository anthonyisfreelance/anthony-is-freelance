---
// A phone screen standing in a softly blurred copy of itself, as in the Figma innovation tiles.
// The background is always the tile's own screen, blurred, so a row of tiles has different
// backgrounds. A screen recording (public path to an MP4) can play over the still: it starts
// when the tile scrolls into view (the shared script in Base.astro) and is skipped for reduced
// motion. With `controls`, the video shows its own controls and poster instead.
// With anchor="top" the phone hangs from the top of the tile and the recording keeps its bottom edge,
// for an innovation that lives at the bottom of the screen (a sticky bar).
// On hover (inside a .hover-card) the whole tile zooms, backdrop and phone together.
// Without a screen (an innovation whose still hasn't been added yet) it shows an empty phone.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  screen?: ImageMetadata;
  backdrop?: ImageMetadata; // blurred behind the phone; the screen itself when not given
  video?: string;
  controls?: boolean;
  alt?: string;
  label?: string; // accessible name for the video when it has controls
  ratio?: 'square' | 'portrait';
  inset?: string; // horizontal inset of the phone, as a percentage of the tile
  sizes?: string;
  anchor?: 'bottom' | 'top'; // where the phone sits in the tile; 'top' keeps the bottom of the screen in view
  class?: string;
}
const { screen, backdrop, video, controls = false, alt = '', label, ratio = 'square', inset, sizes = '(min-width: 1024px) 15vw, 40vw', anchor = 'bottom', class: className = '' } = Astro.props;
const pin = anchor === 'top' ? 'top-0' : 'bottom-0';
const crop = anchor === 'top' ? 'object-bottom' : 'object-top';
const side = inset ?? (ratio === 'portrait' ? '17.63%' : '24.5%');
const poster = screen && video && controls ? (await getImage({ src: screen, width: 660 })).src : undefined;
---
{!screen ? (
  <div class:list={['relative overflow-hidden bg-raised', ratio === 'portrait' ? 'aspect-[4/5]' : 'aspect-square', className]} aria-hidden="true">
    <div class:list={['absolute flex aspect-[216/376] items-center justify-center border border-line', pin, anchor === 'top' ? 'border-t-0' : 'border-b-0']} style={`left:${side};right:${side}`}>
      <span class="t-badge px-2 text-center text-muted">Recording to come</span>
    </div>
  </div>
) : (
<div class:list={['relative overflow-hidden bg-white', ratio === 'portrait' ? 'aspect-[4/5]' : 'aspect-square', className]}>
  <div class="zoom-img absolute inset-0">
    <div class="absolute inset-0 scale-125 blur-[60px]" aria-hidden="true">
      <Image src={backdrop ?? screen} alt="" width={200} class="absolute inset-0 size-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-white/20"></div>
    <div class:list={['absolute aspect-[216/376] overflow-hidden', pin]} style={`left:${side};right:${side}`}>
      <Image src={screen} alt={alt} widths={[220, 440, 660]} sizes={sizes} class:list={['size-full object-cover', crop]} />
      {video && (controls ? (
        <video
          src={video}
          poster={poster}
          data-autoplay
          controls
          muted
          loop
          playsinline
          preload="none"
          aria-label={label}
          class:list={['absolute inset-0 size-full object-cover', crop]}
        ></video>
      ) : (
        <video
          src={video}
          data-autoplay
          data-fade
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          class:list={['absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300', crop]}
        ></video>
      ))}
    </div>
  </div>
</div>
)}
