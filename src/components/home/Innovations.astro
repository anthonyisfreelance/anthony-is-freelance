---
import SectionIntro from '../SectionIntro.astro';
import TextLink from '../TextLink.astro';
import ScreenTile from '../ScreenTile.astro';
import { INNOVATIONS } from '../../data/home';
---
<section class="px-margin pt-section-pre">
  <div class="border-t border-line pt-section">
    <SectionIntro eyebrow={INNOVATIONS.eyebrow} heading={INNOVATIONS.heading}>
      <TextLink slot="links" href={INNOVATIONS.link.href}>{INNOVATIONS.link.label}</TextLink>
    </SectionIntro>
    <ul class="mt-large grid grid-cols-2 gap-x-grid gap-y-section-sm lg:grid-cols-3 lg:gap-y-large">
      {INNOVATIONS.items.map((item, i) => (
        <li class:list={['hover-card relative flex flex-col', i > 1 && 'max-lg:hidden']}>
          <ScreenTile screen={item.image} video={item.video} anchor={item.anchor} sizes="(min-width: 1024px) 16vw, 25vw" />
          <div class="flex flex-col gap-3 pt-grid">
            <h3 class="t-h6 text-ink">
              <a href={item.href} class="stretched-link link-hover"><span class="sr-only">{item.client}. </span>{item.title}</a>
            </h3>
            <p class="t-body text-muted">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
