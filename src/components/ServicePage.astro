---
// Service page template. Every service page uses this, in the same section order
// (Figma "Services - Sub Page"; page-copy/service-pages.md "The page model").
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Schema from './Schema.astro';
import Header from './Header.astro';
import Heading from './Heading.astro';
import SectionIntro from './SectionIntro.astro';
import TextLink from './TextLink.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import ScreenTile from './ScreenTile.astro';
import { INNOVATIONS_LIST } from '../data/innovations';
import TrustTiles from './TrustTiles.astro';
import ServiceExtra from './ServiceExtra.astro';
import TestimonialSection from './TestimonialSection.astro';
import Faqs from './home/Faqs.astro';
import Contact from './home/Contact.astro';
import { SITE, ENTITY, URLS } from '../data/site';
import type { ServicePage, Slot } from '../data/service-pages/types';

interface Props { page: ServicePage }
const { page: p } = Astro.props;

const url = new URL(p.meta.path, SITE).href;
const serviceId = `${url}#service`;
const service = {
  '@type': 'Service',
  '@id': serviceId,
  name: p.meta.name,
  serviceType: p.meta.serviceType,
  description: p.hero.intro.split('. ')[0] + '.',
  provider: { '@id': ENTITY.person.id },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  url,
  ...(p.meta.minPrice
    ? {
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: p.meta.minPrice,
            priceCurrency: 'GBP',
            valueAddedTaxIncluded: false,
            description: 'Design only. The build is quoted separately by the developer.',
          },
        },
      }
    : {}),
};
const breadcrumbs = [
  { name: 'Home', path: URLS.home },
  { name: 'Shopify website design services', path: URLS.services },
  { name: p.meta.name, path: p.meta.path },
];
// "To come" notes stay in the data files and never show: a section with nothing in it is left out.
const after = (slot: Slot) => (p.extras ?? []).filter((x) => x.after === slot && x.kind !== 'todo');
const faqSchema = [
  ...(p.extras ?? []).flatMap((x) => (x.kind === 'text' && x.faq ? [{ q: x.heading, a: x.paragraphs ?? [] }] : [])),
  ...(p.faqs?.items ?? []),
];
// Proof: two cards, two columns. Three: three across on desktop; on phones one large, then two smaller
// (as the homepage). Four: two by two everywhere.
const proofCount = p.proof?.cards.length ?? 0;
const proofCols = proofCount === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2';
const proofSizes = proofCount === 3 ? '(min-width: 1024px) 31vw' : '(min-width: 1024px) 48vw';
const bigFirst = proofCount % 2 === 1; // odd counts: the first card spans both columns on phones
// Articles: one column per article on desktop (up to four), two on phones; a single article isn't a section.
const articleCount = p.articles?.items.length ?? 0;
const articleCols = ({ 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' } as Record<number, string>)[Math.min(articleCount, 4)] ?? 'lg:grid-cols-2';
// Comparison: this page's service is always the first column.
const cmpOrder = p.comparison ? p.comparison.columns.map((c, i) => ({ c, i })).sort((a, b) => Number(!!b.c.current) - Number(!!a.c.current)).map((x) => x.i) : [];
const cmp = p.comparison
  ? {
      ...p.comparison,
      columns: cmpOrder.map((i) => p.comparison!.columns[i]),
      rows: p.comparison.rows.map(([label, ...v]) => [label, ...cmpOrder.map((i) => v[i])] as [string, string, string]),
      examples: p.comparison.examples && cmpOrder.map((i) => p.comparison!.examples![i]),
    }
  : undefined;
// Testimonial logo: the client's logo, found from the company named in the credit.
const TESTIMONIAL_LOGOS: [string, string][] = [
  ['Whistlefish', 'whistlefish'], ['Hartnack', 'hartnack-and-co'], ['East West Apparel', 'east-west-apparel'],
  ['Window Fleur', 'window-fleur'], ['Drink Finder', 'drink-finder'], ['East at Home', 'east-at-home'], ['Fuzzball', 'fuzzball'], ['Zen Maitri', 'zen-maitri'],
];
const testimonialLogo = p.testimonial && TESTIMONIAL_LOGOS.find(([name]) => p.testimonial!.cite.includes(name))?.[1];
const h3caps = 'font-display text-[length:var(--type-h5)] font-medium uppercase leading-[1.1] text-ink lg:text-[length:var(--type-h3)]';
const cell = 't-label tracking-[0.02em]';
---
<Base title={p.meta.title} description={p.meta.description}>
  <Schema slot="head" title={p.meta.title} description={p.meta.description} path={p.meta.path} breadcrumbs={breadcrumbs} faqs={faqSchema} extra={[service]} about={serviceId} mainEntity={serviceId} />
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="px-margin">
      <div class="grid gap-large border-t border-line pt-large lg:grid-cols-2 lg:gap-grid lg:pt-[40px]">
        <div class="flex flex-col">
          <Heading level={1} eyebrow={p.hero.eyebrow}>{p.hero.heading}</Heading>
          <p class="t-body mt-loose text-muted lg:max-w-[676px]">{p.hero.intro}</p>
          <div class="mt-large lg:mt-[38px]"><TextLink href={p.hero.cta.href}>{p.hero.cta.label}</TextLink></div>
        </div>
        <div>
          {p.hero.image ? (
            <div class="relative aspect-[4/3] overflow-hidden bg-line lg:aspect-auto lg:h-[450px]">
              <Image src={p.hero.image} alt={p.hero.imageAlt ?? ''} widths={[400, 700, 1000, 1400]} sizes="(min-width: 1024px) 48vw, calc(100vw - 32px)" quality={75} loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover" />
            </div>
          ) : (
            <div class="aspect-[4/3] lg:aspect-auto lg:h-[450px] grid place-items-center bg-line"><span class="t-badge text-muted">[Lead work to come]</span></div>
          )}
        </div>
      </div>
    </section>

    <!-- Trust row -->
    <section class="px-margin pt-large lg:pt-[40px]" aria-label="Why clients choose this service">
      <TrustTiles items={p.trust.map((text) => ({ text }))} />
    </section>
    {after('trust').map((x) => <ServiceExtra item={x} />)}

    <!-- What's included, and who it's for. List items in Label/Eyebrow type (Figma 48277:2856, feedback #131). -->
    <section id="whats-included" class="px-margin pt-section">
      <div class="grid gap-section-sm lg:grid-cols-2 lg:gap-gutter">
        {[p.included, p.fit].map((block, b) => (
          <div id={b === 1 ? 'right-fit' : undefined}>
            <h2 class:list={[h3caps, 'border-t border-line pt-section']}>{block.heading}</h2>
            <ul class="mt-large flex flex-col gap-4 lg:mt-10">
              {block.items.map((item) => (
                <li class="t-label bg-raised px-4 py-4 text-ink lg:px-6 lg:py-6">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
    {after('included').map((x) => <ServiceExtra item={x} />)}

    <!-- Proof -->
    {p.proof && (
    <section id="proof" class="px-margin pt-section">
      <div class="border-t border-line pt-section">
        <div class="flex flex-col gap-loose lg:flex-row lg:items-end lg:justify-between lg:gap-gutter">
          <h2 class="t-h2 text-ink lg:w-half">{p.proof.heading}</h2>
          {p.proof.link && <TextLink href={p.proof.link.href}>{p.proof.link.label}</TextLink>}
        </div>
        <ul class:list={['cards-align mt-gutter grid grid-cols-2 gap-x-grid gap-y-large', proofCols]}>
          {p.proof.cards.map((c, i) => {
            const big = bigFirst && i === 0;
            return (
              <li class:list={[big && 'col-span-2 lg:col-span-1']}>
                <CaseStudyCard {...c} ratio={big ? 'square-portrait' : 'portrait'} stackMeta={!big} sizes={`${proofSizes}, ${big ? 'calc(100vw - 32px)' : 'calc(50vw - 24px)'}`} />
              </li>
            );
          })}
        </ul>
      </div>
    </section>
    )}
    {after('proof').map((x) => <ServiceExtra item={x} />)}

    <!-- Routing: when this isn't the right call -->
    <section class="px-margin pt-section">
      <div class="grid gap-gutter border-t border-line pt-4 lg:grid-cols-2">
        <div class="pt-section lg:sticky lg:top-0 lg:self-start">
          <Heading eyebrow={p.routing.eyebrow}>{p.routing.heading}</Heading>
          {p.routing.intro && <p class="t-body mt-loose text-muted">{p.routing.intro}</p>}
        </div>
        <ul class="flex flex-col gap-section-sm lg:gap-large lg:pt-section">
          {p.routing.routes.map((r, i) => (
            <li class:list={['flex flex-col gap-6', i > 0 && 'border-t border-line pt-section-sm lg:pt-large']}>
              <h3 class="t-h6 text-ink">{r.situation}</h3>
              <p class="t-body text-muted">{r.body}</p>
              {r.links.length > 0 && (
                <p class="flex flex-wrap gap-x-grid gap-y-2">
                  {r.links.map((l) => <TextLink href={l.href}>{l.label}</TextLink>)}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
      {p.routing.note && <p class="t-body mt-large border-t border-line pt-loose text-muted lg:ml-[calc(50%+20px)]">{p.routing.note}</p>}
    </section>
    {after('routing').map((x) => <ServiceExtra item={x} />)}

    <!-- How it runs -->
    <section id="how-it-runs" class="px-margin pt-section">
      <div class="border-t border-line pt-section">
        <div class="flex flex-col gap-loose lg:flex-row lg:items-end lg:gap-gutter">
          <div class="lg:w-half lg:shrink-0"><Heading eyebrow={p.process.eyebrow}>{p.process.heading}</Heading></div>
          <p class="t-body flex-1 text-muted">{p.process.intro}</p>
        </div>
        <ol class="mt-large grid grid-cols-2 gap-x-grid gap-y-large lg:mt-gutter lg:grid-cols-4 lg:gap-large">
          {p.process.steps.map((s, i) => (
            <li class="flex flex-col gap-4 border-t border-line pr-grid pt-loose">
              <span class="t-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex flex-col gap-3">
                <h3 class="t-h5 uppercase text-ink">{s.title}</h3>
                <p class="t-body text-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
    {after('process').map((x) => <ServiceExtra item={x} />)}

    <!-- Innovations -->
    {p.innovations && (
      <section id="innovations" class="px-margin pt-section">
        <div class="border-t border-line pt-section">
          <div class="lg:w-half">
            <Heading eyebrow={p.innovations.eyebrow}>{p.innovations.heading}</Heading>
            {p.innovations.intro && <p class="t-body mt-loose text-muted">{p.innovations.intro}</p>}
          </div>
          <ul class="mt-gutter grid gap-x-grid gap-y-section sm:grid-cols-3 sm:gap-y-gutter">
            {p.innovations.items.map((it) => {
              // Matched to its innovation record by name; an item without one shows an empty phone.
              const rec = INNOVATIONS_LIST.find((r) => r.name === it.title);
              return (
              <li class:list={['flex flex-col', rec && 'hover-card relative']}>
                <ScreenTile screen={rec?.poster ?? it.screen} video={rec?.video ?? it.video} alt={rec?.alt} anchor={rec?.anchor} sizes="(min-width: 640px) 16vw, 50vw" />
                <div class="flex flex-col gap-3 pt-grid">
                  <h3 class="t-h6 text-ink">
                    {rec ? (
                      <a href={`${URLS.innovations}#${rec.slug}`} class="stretched-link link-hover"><span class="sr-only">{it.client}. </span>{it.title}</a>
                    ) : (
                      <><span class="sr-only">{it.client}. </span>{it.title}</>
                    )}
                  </h3>
                  <p class="t-body text-muted">{it.body}</p>
                </div>
              </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}
    {after('innovations').map((x) => <ServiceExtra item={x} />)}

    <!-- Testimonial (same section as the services hub) -->
    {p.testimonial && <TestimonialSection heading={p.testimonial.heading} quote={p.testimonial.quote} cite={p.testimonial.cite} logo={testimonialLogo} />}
    {after('testimonial').map((x) => <ServiceExtra item={x} />)}

    <!-- Price and timeline (Figma "Pricing table", Grid variant): heading, notes and quote link sticky
         on the left; the table on the right with its values on the raised surface. -->
    <section id="price" class="px-margin pt-section">
      <div class="grid gap-gutter border-t border-line pt-6 lg:grid-cols-2">
        <div class="pt-section lg:sticky lg:top-0 lg:self-start lg:pr-[119px]">
          <Heading eyebrow={p.price.eyebrow}>{p.price.heading}</Heading>
          <div class="t-body mt-loose flex flex-col gap-[10px] text-muted">{p.price.notes.map((n) => <p>{n}</p>)}</div>
          <div class="mt-loose"><TextLink href={p.price.cta.href}>{p.price.cta.label}</TextLink></div>
        </div>
        <div class="lg:pt-[104px]">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">{p.price.caption}</caption>
            <thead>
              <tr>
                <td class="w-[110px] lg:w-[141px]"></td>
                <th scope="col" class="t-button-lg px-4 py-loose font-medium text-ink lg:px-grid-lg">{p.meta.name}</th>
              </tr>
            </thead>
            <tbody>
              {p.price.rows.map(([label, value]) => (
                <tr>
                  <th scope="row" class={`${cell} border-t border-line py-loose pr-3 align-top font-medium text-muted`}>{label}</th>
                  <td class={`${cell} border-t border-line bg-raised px-4 py-loose align-top text-ink lg:px-grid-lg`}>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
    {after('price').map((x) => <ServiceExtra item={x} />)}

    <!-- Comparison -->
    {cmp && (
      <section class="px-margin pt-section">
        <div class="border-t border-line pt-section">
          <div class="lg:w-half">
            <Heading eyebrow={cmp.eyebrow}>{cmp.heading}</Heading>
            <p class="t-body mt-loose text-muted" aria-hidden="true">{cmp.caption}</p>
          </div>
          <div class="mt-gutter">
            <table class="cmp w-full border-collapse text-left">
              <caption class="sr-only">{cmp.caption}</caption>
              <thead>
                <tr>
                  <td class="w-[220px]"></td>
                  {cmp.columns.map((c) => (
                    <th scope="col" class:list={['t-button-lg px-grid py-loose font-medium text-ink', c.current && 'bg-raised']}>
                      {c.label}{c.current && <span class="sr-only"> (you're here)</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {cmp.rows.map(([label, ...values]) => (
                  <tr>
                    <th scope="row" class={`${cell} border-t border-line py-loose pr-4 align-middle font-medium text-muted`}>{label}</th>
                    {values.map((v, i) => (
                      <td class:list={[cell, 'border-t border-line px-grid py-loose align-middle text-ink', cmp!.columns[i].current && 'bg-raised']}>{v}</td>
                    ))}
                  </tr>
                ))}
                {cmp.examples && (
                  <tr>
                    <th scope="row" class={`${cell} border-t border-line py-loose pr-4 align-middle font-medium text-muted`}>Example</th>
                    {cmp.examples.map((e, i) => (
                      <td class:list={['border-t border-line px-grid py-loose align-top', cmp!.columns[i].current && 'bg-raised']}>
                        <a href={e.href} class="hover-card flex flex-col gap-3 lg:flex-row lg:items-end lg:gap-grid">
                          {e.screen ? <ScreenTile screen={e.screen} alt={e.alt} sizes="(min-width: 1024px) 300px, 40vw" class="lg:w-[300px] lg:shrink-0" /> : <div class="aspect-square grid place-items-center bg-line lg:w-[300px] lg:shrink-0"><span class="t-badge text-muted">[Image to come]</span></div>}
                          <span class="font-display text-[12px] font-medium leading-[1.3] tracking-[0.02em] text-ink underline underline-offset-4 hover:decoration-2">{e.client}</span>
                        </a>
                      </td>
                    ))}
                  </tr>
                )}
                <!-- Last row (no rule above it): get a quote for this service, or go to the other one -->
                <tr>
                  <td class="max-lg:hidden"></td>
                  {cmp.columns.map((c) => (
                    <td class:list={['px-grid py-loose align-middle', c.current && 'bg-raised']}>
                      {c.current ? (
                        <a href={p.price.cta.href} data-project-open class="t-button inline-flex items-center gap-1 bg-white px-[14px] py-2 text-[#111] hover:opacity-90">
                          {p.price.cta.label}
                          <img src="/icons/plus-dark.svg" alt="" width="18" height="18" class="size-[18px]" />
                        </a>
                      ) : (
                        <a href={c.href} class="t-button inline-flex items-center gap-1 text-ink link-hover">
                          {c.label}
                          <img src="/icons/arrow-right.svg" alt="" width="18" height="18" class="size-[18px]" />
                        </a>
                      )}
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
            {cmp.notes && <div class="t-small mt-large flex flex-col gap-[10px] text-muted">{cmp.notes.map((n) => <p>{n}</p>)}</div>}
          </div>
        </div>
      </section>
    )}

    {after('comparison').map((x) => <ServiceExtra item={x} />)}

    {p.faqs ? <div id="questions"><Faqs data={p.faqs} /></div> : <div class="pb-section"></div>}
    {after('faqs').map((x) => <ServiceExtra item={x} />)}

    <!-- Articles -->
    {p.articles && articleCount > 1 && (
      <section class="px-margin pb-section">
        <div class="border-t border-line pt-section">
          <SectionIntro eyebrow={p.articles.eyebrow} heading={p.articles.heading}>
            <TextLink slot="links" href={p.articles.link.href}>{p.articles.link.label}</TextLink>
          </SectionIntro>
          <ul class:list={['mt-grid-lg grid grid-cols-2 gap-x-grid gap-y-large', articleCols]}>
            {p.articles.items.slice(0, 4).map((a, i) => (
              <li class:list={[i > 1 && 'max-lg:hidden']}>
                <article class="hover-card relative flex flex-col">
                  <div class="aspect-video bg-line" aria-hidden="true"></div>
                  <div class="flex flex-col gap-2 pt-2">
                    <p class="t-badge border-b border-line pb-2 text-muted">{a.category}</p>
                    <h3 class="t-h6 text-ink"><a href={a.href} class="stretched-link link-hover">{a.title}</a></h3>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <Contact eyebrow={p.cta?.eyebrow} heading={p.cta?.heading} />
  </main>
</Base>

<style>
  /* Comparison table: on phones each row stacks, label on top, the two services side by side. */
  @media (max-width: 1023px) {
    .cmp, .cmp thead, .cmp tbody { display: block; }
    .cmp tr { display: grid; grid-template-columns: 1fr 1fr; }
    .cmp tr > :first-child { grid-column: 1 / -1; padding-bottom: 8px; }
    .cmp thead tr > :first-child { display: none; }
    .cmp tbody tr > :not(:first-child) { border-top: 0; padding-top: 12px; }
  }
</style>
