---
// Services hub. Ranks for service nouns ("Shopify website design services"); the homepage keeps the designer terms.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Heading from '../../components/Heading.astro';
import TextLink from '../../components/TextLink.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import Faqs from '../../components/home/Faqs.astro';
import Contact from '../../components/home/Contact.astro';
import { SITE, ENTITY } from '../../data/site';
import {
  HUB_META, HUB_HERO, SERVICES_LIST, SERVICES_GRID, SITUATIONS, RECENT_WORK, HUB_TESTIMONIAL, HUB_FAQS, formatPrice,
} from '../../data/services';

const url = new URL(HUB_META.path, SITE).href;
const catalog = {
  '@type': 'OfferCatalog',
  '@id': `${url}#catalog`,
  name: 'Shopify website design services',
  itemListElement: SERVICES_LIST.map((s) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: s.name,
      serviceType: s.serviceType,
      provider: { '@id': ENTITY.person.id },
      areaServed: { '@type': 'Country', name: 'United Kingdom' },
      url: new URL(s.href, SITE).href,
    },
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: s.price,
      priceCurrency: 'GBP',
      valueAddedTaxIncluded: false,
      description: 'Design only. The build is quoted separately by the developer.',
    },
  })),
};
---
<Base title={HUB_META.title} description={HUB_META.description}>
  <Schema
    slot="head"
    title={HUB_META.title}
    description={HUB_META.description}
    path={HUB_META.path}
    faqs={HUB_FAQS.items}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Shopify website design services', path: HUB_META.path }]}
    mainEntity={`${url}#catalog`}
    extra={[catalog]}
  />
  <Header />
  <main id="main">
    <PageHero eyebrow={HUB_HERO.eyebrow} heading={HUB_HERO.heading} intro={HUB_HERO.intro}>
      <nav aria-label="Shopify website design services">
        <ul class="flex flex-wrap gap-x-grid gap-y-4">
          {SERVICES_LIST.map((s) => <li><TextLink href={s.href}>{s.name}</TextLink></li>)}
        </ul>
      </nav>
    </PageHero>

    <div class="px-margin pt-section-sm">
      <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto lg:h-[419px]">
        <Image src={HUB_HERO.image} alt="" widths={[480, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={75} class="absolute inset-0 size-full object-cover" />
      </div>
    </div>

    <!-- Trust row: first and last items sit on the raised surface, rules between (Figma) -->
    <ul class="t-label grid grid-cols-1 gap-3 px-margin pt-large tracking-[0.02em] text-ink sm:grid-cols-2 lg:flex lg:items-stretch lg:gap-grid">
      {HUB_HERO.trust.map((t, i) => (
        <>
          {i > 0 && <li aria-hidden="true" class="hidden w-px self-stretch bg-line lg:block"></li>}
          <li class:list={['flex items-center gap-2', t.raised ? 'bg-[#1b1b1b] p-3' : 'lg:py-3', i === HUB_HERO.trust.length - 1 ? 'lg:shrink-0' : 'lg:flex-1', i === 0 && 'justify-center']}>
            {t.google && <img src="/icons/google-g.png" alt="Google" width="25" height="25" class="size-[25px]" />}
            <span>{t.text}</span>
          </li>
        </>
      ))}
    </ul>

    <!-- Eight services -->
    <section class="px-margin pt-large">
      <div class="border-t border-line pt-section">
        <SectionIntro eyebrow={SERVICES_GRID.eyebrow} heading={SERVICES_GRID.heading}>
          <p slot="intro">{SERVICES_GRID.intro}</p>
        </SectionIntro>
        <ul class="mt-gutter grid gap-x-grid gap-y-gutter sm:grid-cols-2 lg:grid-cols-4">
          {SERVICES_LIST.map((s) => (
            <li class="relative flex flex-col gap-loose">
              <div class="relative aspect-square overflow-hidden bg-line">
                <Image src={s.image} alt="" widths={[300, 450, 700]} sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 100vw" quality={75} class="absolute inset-0 size-full object-cover" />
              </div>
              <div class="flex flex-1 flex-col gap-loose">
                <h3 class="t-h5 flex items-start justify-between gap-2 uppercase text-ink">
                  <a href={s.href} class="stretched-link hover:opacity-80">{s.name}</a>
                  <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="mt-[2px] size-[18px] shrink-0" loading="lazy" />
                </h3>
                <p class="t-body flex-1 text-muted">{s.body}</p>
                <p class="t-label border-t border-line pt-loose tracking-[0.02em] text-muted">{formatPrice(s.price)}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="t-small mt-large text-muted">{SERVICES_GRID.note}</p>
      </div>
    </section>

    <!-- Situation guide -->
    <section class="px-margin pt-section">
      <div class="grid gap-gutter border-t border-line pt-4 lg:grid-cols-2">
        <div class="pt-section lg:sticky lg:top-0 lg:self-start">
          <Heading eyebrow={SITUATIONS.eyebrow}>{SITUATIONS.heading}</Heading>
          <p class="t-body mt-loose text-muted">{SITUATIONS.intro}</p>
        </div>
        <ul class="flex flex-col gap-large lg:pt-section">
          {SITUATIONS.items.map((it, i) => (
            <li class:list={['flex items-start gap-grid', i > 0 && 'border-t border-line pt-large']}>
              <div class="grid flex-1 gap-x-grid gap-y-3 sm:grid-cols-[minmax(0,0.75fr)_minmax(0,1fr)]">
                <h3 class="t-h5 uppercase text-ink">“{it.quote}”</h3>
                <p class="t-body text-muted">
                  {it.body.map((part) => part.href ? <a href={part.href} class="text-ink underline underline-offset-2 hover:opacity-80">{part.text}</a> : part.text)}
                </p>
              </div>
              <a href={it.href} aria-label={`Go to the service for: ${it.quote}`} class="shrink-0 hover:opacity-70">
                <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" class="size-[18px]" loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Recent work -->
    <section class="pt-section">
      <div class="px-margin">
        <div class="border-t border-line pt-section">
          <SectionIntro eyebrow={RECENT_WORK.eyebrow} heading={RECENT_WORK.heading}>
            <TextLink slot="links" href={RECENT_WORK.link.href}>{RECENT_WORK.link.label}</TextLink>
          </SectionIntro>
        </div>
      </div>
      <ul class="mt-gutter grid grid-cols-2 gap-x-grid gap-y-grid-lg px-margin lg:grid-cols-3">
        {RECENT_WORK.cards.map((c) => <li><CaseStudyCard {...c} stackMeta /></li>)}
      </ul>
    </section>

    <!-- Testimonial -->
    <section class="px-margin pt-section">
      <div class="flex flex-col gap-gutter border-t border-line pt-section lg:flex-row">
        <div class="flex-1"><Heading eyebrow={HUB_TESTIMONIAL.eyebrow}>{HUB_TESTIMONIAL.heading}</Heading></div>
        <figure class="flex flex-col gap-grid-lg border-t border-line pt-large lg:w-[676px] lg:max-w-[48%]">
          <blockquote class="font-display text-[length:var(--type-h2)] font-medium leading-[1.3] text-ink">“{HUB_TESTIMONIAL.quote}”</blockquote>
          <figcaption class="t-label text-muted">{HUB_TESTIMONIAL.cite}</figcaption>
        </figure>
      </div>
    </section>

    <Faqs data={HUB_FAQS} />
    <Contact />
  </main>
</Base>
