---
// The start-a-project form (Figma "Contact Form"). Used in place at the foot of pages
// (home/Contact.astro) and in the overlay that every Start a project button opens (ProjectDialog.astro).
// Phones: 12px labels, 34px fields, two-column budget, full-width Send with an arrow.
// From 1024px: 14px labels, 42px fields, three columns, Send message.
import { CONTACT } from '../data/home';
const field = 't-tile h-[34px] w-full border border-line bg-surface px-3 text-ink placeholder:text-muted lg:h-[42px]';
const label = 't-tile text-ink';
---
<!-- [CONFIRM] form handling: a small Cloudflare function that emails the enquiry -->
<form method="post" class="flex flex-col gap-6">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <label class="flex flex-col gap-2"><span class={label}>Name</span><input class={field} type="text" name="name" autocomplete="name" required /></label>
    <label class="flex flex-col gap-2"><span class={label}>Email</span><input class={field} type="email" name="email" autocomplete="email" required /></label>
    <label class="col-span-2 flex flex-col gap-2 lg:col-span-1"><span class={label}>Your website</span><input class={field} type="text" name="website" placeholder="Yourstore.com" inputmode="url" autocomplete="url" /></label>
  </div>
  <fieldset class="flex flex-col gap-2">
    <legend class={`${label} mb-2`}>Budget</legend>
    <div class="grid grid-cols-2 gap-2 lg:grid-cols-3 lg:gap-x-4">
      {CONTACT.budgets.map((b) => (
        <label class="t-tile flex cursor-pointer items-center gap-2 border border-line px-3 py-2 text-muted has-[:checked]:border-ink has-[:checked]:text-ink has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-blue lg:py-3">
          <input type="radio" name="budget" value={b} class="size-[14px] shrink-0 appearance-none rounded-full border border-ink checked:bg-[radial-gradient(circle,var(--c-text)_45%,transparent_50%)] focus-visible:outline-none" />
          {b}
        </label>
      ))}
    </div>
  </fieldset>
  <label class="flex flex-col gap-2">
    <span class={label}>Message (optional)</span>
    <textarea name="message" placeholder="Type your message..." class={`${field} h-[99px] resize-y py-3 lg:h-[174px]`}></textarea>
  </label>
  <div>
    <button type="submit" class="t-button-lg flex w-full cursor-pointer items-center justify-between gap-2 bg-ink px-4 py-[15px] text-surface hover:opacity-90 lg:w-auto">
      <span class="lg:hidden">Send</span><span class="hidden lg:inline">Send message</span>
      <img src="/icons/arrow-right.svg" alt="" width="18" height="18" class="size-[18px] lg:hidden" />
    </button>
  </div>
</form>
