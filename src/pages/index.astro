---
import Base from '../layouts/Base.astro';
import Schema from '../components/Schema.astro';
import Hero from '../components/home/Hero.astro';
import Brands from '../components/home/Brands.astro';
import Services from '../components/home/Services.astro';
import About from '../components/home/About.astro';
import Process from '../components/home/Process.astro';
import Innovations from '../components/home/Innovations.astro';
import Results from '../components/home/Results.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Articles from '../components/home/Articles.astro';
import Faqs from '../components/home/Faqs.astro';
import Contact from '../components/home/Contact.astro';
import { META, FAQS } from '../data/home';
---
<Base title={META.title} description={META.description}>
  <Schema slot="head" title={META.title} description={META.description} path="/" faqs={FAQS.items} isHome />
  <main id="main">
    <Hero />
    <Brands />
    <Services />
    <About />
    <Process />
    <Innovations />
    <Results />
    <Testimonials />
    <Articles />
    <Faqs />
    <Contact />
  </main>
</Base>
